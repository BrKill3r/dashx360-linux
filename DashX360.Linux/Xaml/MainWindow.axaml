                  </Grid>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="172,198,0,0" Width="170" Height="360" Background="#22FFFFFF" ClipToBounds="True" BorderThickness="0">
                  <Border.Theme>
                    <ControlTheme TargetType="Border">
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesAchievementListFocused}" Value="False">
