                          <Border Width="168" Height="102" HorizontalAlignment="Right" VerticalAlignment="Center" CornerRadius="0,14,14,0">
                            <Border.Theme>
                              <ControlTheme TargetType="Border">
                                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <w:Setter Property="Background" Value="#7FE8FFE2"/>
                                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
                              </ControlTheme>
                            </Border.Theme>
                          </Border>
                          <Image Width="76" Height="76" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" RenderOptions.BitmapInterpolationMode="HighQuality" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
                <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="368,214,0,0" Width="754" Height="344" Background="#00FFFFFF" ClipToBounds="True" BorderThickness="0">
                  <Border.Theme>
                    <ControlTheme TargetType="Border">
                      <Setter Property="Opacity" Value="0.92"/>
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesAchievementListFocused}" Value="True">
                          <w:Setter Property="Opacity" Value="1"/>
                        </w:DataTrigger></w:TriggerCollection></Template></Setter>
                    </ControlTheme>
                  </Border.Theme>
                  <ListBox x:Name="BladesAchievementListBox" ItemsSource="{Binding BladesAchievementItems}" SelectedIndex="{Binding SelectedBladesAchievementIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="#00FFFFFF" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" Focusable="True" IsHitTestVisible="True" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ListBox.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.ItemContainerTheme>
                      <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Width" Value="104"/>
                        <Setter Property="Height" Value="92"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0,0,16,22"/>
                        <Setter Property="Background" Value="#00FFFFFF"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        
                        <Setter Property="Focusable" Value="False"/>
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </ControlTheme>
                    </ListBox.ItemContainerTheme>
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Width="104" Height="92">
                          <Border Width="98" Height="86" BorderThickness="3" CornerRadius="8">
                            <Border.Theme>
                              <ControlTheme TargetType="Border">
                                <Setter Property="Background" Value="#442E8A2C"/>
                                <Setter Property="BorderBrush" Value="#873B6D31"/>
                                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <w:Setter Property="Background" Value="#6633772E"/>
                                    <w:Setter Property="BorderBrush" Value="#E0D9F0CB"/>
                                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
                              </ControlTheme>
                            </Border.Theme>
                          </Border>
                          <Image Width="68" Height="68" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="UniformToFill" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" RenderOptions.BitmapInterpolationMode="HighQuality" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Border>
                <Border Height="116" VerticalAlignment="Bottom" Background="#78316F2F"/>
                <Canvas Width="950" Height="62" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="170,0,0,34">
                  <Border Width="24" Height="24" CornerRadius="12" Background="#65D8EBD0" Canvas.Left="12" Canvas.Top="0">
                    <TextBlock Text="Y" Foreground="#77555555" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <Border Width="24" Height="24" CornerRadius="12" Background="#65D8EBD0" Canvas.Left="-6" Canvas.Top="31">
                    <TextBlock Text="X" Foreground="#77555555" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                  </Border>
                  <TextBlock Text="Back" FontSize="22" Canvas.Left="742" Canvas.Top="3" Theme="{StaticResource BladeFooterTextStyle}"/>
                  <controls:BladePadGlyph Letter="B" Width="26" Height="26" Canvas.Left="815" Canvas.Top="3"/>
                  <TextBlock Text="Select" FontSize="22" Canvas.Left="742" Canvas.Top="36" Theme="{StaticResource BladeFooterTextStyle}"/>
                  <controls:BladePadGlyph Letter="A" Width="26" Height="26" Canvas.Left="815" Canvas.Top="36"/>
                </Canvas>
              </Grid>
            </Canvas>
              </Canvas>
            </Viewbox>
          </Grid>
          <Grid Name="ContentFrame" Row="1" Width="1280" Height="502" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False">
            <Grid.Theme>
              <ControlTheme TargetType="Grid">
                <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                    <w:Setter Property="Visibility" Value="Collapsed"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </Grid.Theme>
            <ContentControl Name="ContentHost" Width="1280" Height="502" HorizontalAlignment="Left" VerticalAlignment="Top" Content="{Binding CurrentTab}" ZIndex="2" RenderTransformOrigin="0%,0%">
              <ContentControl.RenderTransform>
                <TranslateTransform X="0"/>
              </ContentControl.RenderTransform>
            </ContentControl>
            <Canvas Name="TabTransitionLayer" Width="1280" Height="502" ZIndex="60" ClipToBounds="True" IsHitTestVisible="False" Focusable="False" w:Wpf.Visibility="Collapsed">
              <Canvas Name="TabTransitionStrip" Width="3840" Height="502" RenderTransformOrigin="0%,0%">
                <Canvas.RenderTransform>
                  <TranslateTransform X="-1280"/>
                </Canvas.RenderTransform>
                <ContentControl Name="TransitionLeftHost" Width="1280" Height="502" Canvas.Left="0" Canvas.Top="0" IsHitTestVisible="False" Focusable="False"/>
                <ContentControl Name="TransitionCenterHost" Width="1280" Height="502" Canvas.Left="1280" Canvas.Top="0" IsHitTestVisible="False" Focusable="False"/>
                <ContentControl Name="TransitionRightHost" Width="1280" Height="502" Canvas.Left="2560" Canvas.Top="0" IsHitTestVisible="False" Focusable="False"/>
              </Canvas>
            </Canvas>
            <Canvas Name="AdjacentPreviewLayer" Width="1280" Height="502" IsHitTestVisible="False" Opacity="0.36" ZIndex="80" ClipToBounds="True">
              <Border Canvas.Left="0" Canvas.Top="0" Width="104" Height="502" ClipToBounds="True">
                <Grid Width="104" Height="502" IsHitTestVisible="False" x:Name="__WpfEvt1" RenderTransformOrigin="0%,0%">
                  <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Grid.RenderTransform>
                  <Image Name="PreviousPreviewImage" Width="104" Height="502" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <Canvas Name="PreviousPreviewLiveLayer" Width="104" Height="502" ClipToBounds="True" w:Wpf.Visibility="Collapsed">
                    <ContentControl Name="PreviousPreviewLiveHost" Width="1280" Height="502" Canvas.Top="0" IsHitTestVisible="False" Focusable="False" Canvas.Left="{Binding LeftPreviewContentLeft}"/>
                  </Canvas>
                </Grid>
              </Border>
              <Border Canvas.Left="1176" Canvas.Top="0" Width="104" Height="502" ClipToBounds="True">
                <Grid Width="104" Height="502" IsHitTestVisible="False" x:Name="__WpfEvt2" RenderTransformOrigin="0%,0%">
                  <Grid.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Grid.RenderTransform>
                  <Image Name="NextPreviewImage" Width="104" Height="502" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  <Canvas Name="NextPreviewLiveLayer" Width="104" Height="502" ClipToBounds="True" w:Wpf.Visibility="Collapsed">
                    <ContentControl Name="NextPreviewLiveHost" Width="1280" Height="502" Canvas.Top="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" IsHitTestVisible="False" Focusable="False" Canvas.Left="{Binding RightPreviewContentLeft}"/>
                  </Canvas>
                </Grid>
              </Border>
            </Canvas>
            <Canvas Name="DebugGuides" Width="1280" Height="502" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
              <Rectangle Width="1280" Height="502" Stroke="#99FF00FF" StrokeThickness="2"/>
              <Line Stroke="#99FFFF00" StrokeThickness="1" StartPoint="0,0" EndPoint="1280,0"/>
              <Line Stroke="#9900FFFF" StrokeThickness="1" StartPoint="198,0" EndPoint="198,502"/>
              <Line Stroke="#9900FFFF" StrokeThickness="1" StartPoint="0,74" EndPoint="1280,74"/>
            </Canvas>
          </Grid>
          <Grid Row="2">
            <Grid.Theme>
              <ControlTheme TargetType="Grid">
                <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                    <w:Setter Property="Visibility" Value="Collapsed"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </Grid.Theme>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="112,16,0,0">
              <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
                <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
              <Border Width="18" Height="18" CornerRadius="9" Background="#FFE0C33C">
                <TextBlock Text="Y" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <TextBlock Text=" Eject" Foreground="#FFFFFFFF" FontSize="15"/>
            </StackPanel>
          </Grid>
        </Grid>
        <Grid Name="GameDetailsOverlay" ZIndex="70" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsDetailsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.Resources>
            <ResourceDictionary>
              <ControlTheme x:Key="GameDetailsTileButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}"/>
                <Setter Property="BorderBrush" Value="#00FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                
                <Setter Property="Padding" Value="16,0,8,17"/>
                <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="Light"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Bottom"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ZIndex" Value="0"/>
                <Setter Property="RenderTransformOrigin" Value="50%,50%"/>
                <Setter Property="RenderTransform">
                  <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                  </Setter.Value>
                </Setter>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Grid><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                          <w:Setter Property="Panel.ZIndex" Value="5"/>
                          <w:Setter TargetName="Root" Property="UIElement.Effect">
                            <w:Setter.Value>
                              <DropShadowEffect BlurRadius="8" Opacity="0.32" Color="Black" OffsetX="3.536" OffsetY="3.536"/>
                            </w:Setter.Value>
                          </w:Setter>
                        </w:Trigger><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                          <w:Setter Property="Panel.ZIndex" Value="5"/>
                          <w:Setter TargetName="Root" Property="UIElement.Effect">
                            <w:Setter.Value>
                              <DropShadowEffect BlurRadius="8" Opacity="0.32" Color="Black" OffsetX="3.536" OffsetY="3.536"/>
                            </w:Setter.Value>
                          </w:Setter>
                        </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                          <w:Setter Property="Background" Value="{w:DynRes MetroTilePressedBrush}"/>
                        </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                        </Border>
                      </Grid>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                
                
                
                
              </ControlTheme>
              <ControlTheme x:Key="GameDetailsTabButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="{Binding Foreground}"/>
                <Setter Property="Background" Value="#00FFFFFF"/>
                <Setter Property="BorderBrush" Value="#00FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0,0,48,0"/>
                <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
                <Setter Property="FontSize" Value="32"/>
                <Setter Property="FontWeight" Value="{Binding FontWeight}"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Focusable" Value="False"/>
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
              <ControlTheme x:Key="GameDetailsExtraTileButtonStyle" TargetType="Button" BasedOn="{StaticResource GameDetailsTileButtonStyle}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="18,8,14,12"/>
                <Setter Property="FontSize" Value="19"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
              </ControlTheme>
            </ResourceDictionary>
          </Grid.Resources>
          <Rectangle Name="GameDetailsTintLayer" Fill="#FF6E6410"/>
          <Image Name="GameDetailsBackgroundImage" Stretch="UniformToFill" Opacity="0.46" Source="{Binding SelectedGame.BackgroundArtPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1280}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Rectangle Name="GameDetailsShadeLayer" Fill="#AA1A1F12"/>
          <Rectangle Name="GameDetailsGradientLayer" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Color="#663D3400" Offset="0"/>
                <GradientStop Color="#33000000" Offset="0.5"/>
                <GradientStop Color="#AA000000" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <ItemsControl Name="GameDetailsTabsChrome" Margin="152,122,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Focusable="False" KeyboardNavigation.IsTabStop="False" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding GameDetailsTabs}" w:Wpf.Visibility="{Binding IsGameDetailsSeeAllOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <ItemsControl.RenderTransform>
              <TranslateTransform X="0"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Focusable="False" Content="{Binding Label}" Command="{Binding DataContext.SelectGameDetailsTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Key}" Theme="{StaticResource GameDetailsTabButtonStyle}" KeyboardNavigation.IsTabStop="False"/>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <TextBlock Name="GameDetailsTitleChrome" Foreground="#FFFFFFFF" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="34" FontWeight="Light" Width="360" TextAlignment="Right" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,94,118,0" Text="{Binding SelectedGame.Title}" w:Wpf.Visibility="{Binding IsGameDetailsSeeAllOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform X="0"/>
            </TextBlock.RenderTransform>
          </TextBlock>
          <Grid Name="GameDetailsOverviewPanel" Width="760" Height="382" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,184,0,0" ClipToBounds="False" w:Wpf.Visibility="{Binding IsGameDetailsOverviewTab, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="165"/>
              <ColumnDefinition Width="165"/>
              <ColumnDefinition Width="330"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="100"/>
              <RowDefinition Height="100"/>
              <RowDefinition Height="162"/>
            </Grid.RowDefinitions>
            <Button Name="SteamDetailsLaunchButton" Grid.Row="0" Grid.Column="0" Content="Launch" Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsSteamGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Name="SteamDetailsStoreButton" Grid.Row="0" Grid.Column="1" Content="Open in Store" Margin="4,0,0,0" Command="{Binding OpenSelectedGameStoreCommand}" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsSteamGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Name="SteamDetailsRateButton" Grid.Row="1" Grid.Column="0" Content="Rate" Margin="0,4,0,0" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsSteamGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Name="SteamDetailsPinButton" Grid.Row="1" Grid.Column="1" Content="Pin to Tray" Margin="4,4,0,0" Command="{Binding SetOpenTrayGameCommand}" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsSteamGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Name="ManualDetailsLaunchButton" Grid.Row="0" Grid.Column="0" Content="Launch" Command="{Binding LaunchGameCommand}" CommandParameter="{Binding SelectedGame}" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsManualGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Button Name="ManualDetailsPinButton" Grid.Row="0" Grid.Column="1" Content="Pin to Tray" Margin="4,0,0,0" Command="{Binding SetOpenTrayGameCommand}" Theme="{StaticResource GameDetailsTileButtonStyle}" w:Wpf.Visibility="{Binding SelectedGame.IsManualGame, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="2" Margin="8,0,0,0" BorderBrush="#44000000" BorderThickness="1" Background="{DynamicResource MetroGreenBrush}">
              <Grid>
                <Border Margin="8" RenderOptions.BitmapInterpolationMode="HighQuality">
                  <Border.Background>
                    <MultiBinding Converter="{StaticResource GameCoverBrushConverter}">
                      <Binding Path="SelectedGame.CoverArtPath"/>
                      <Binding Path="GameCoverFitMode"/>
                      <Binding Path="SelectedGame.CoverZoom"/>
                      <Binding Path="SelectedGame.CoverOffsetX"/>
                      <Binding Path="SelectedGame.CoverOffsetY"/>
                    </MultiBinding>
                  </Border.Background>
                </Border>
                <Image Stretch="UniformToFill" Margin="8" Source="{Binding SelectedGame.DetailsStoreImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=420}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              </Grid>
            </Border>
            <StackPanel Grid.Row="2" Grid.Column="2" Margin="8,5,0,0" Width="315" ClipToBounds="False">
              <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock FontSize="17" FontWeight="Bold" Text="{Binding SelectedGame.DetailsReviewStarsText}" Foreground="{DynamicResource MetroGreenBrush}"/>
                <TextBlock Foreground="#FFFFFFFF" FontSize="15" Margin="8,1,0,0" Text="{Binding SelectedGame.DetailsReviewCountText}"/>
              </StackPanel>
              <TextBlock Foreground="#FFFFFFFF" FontSize="15" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsPlaytimeText}"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="16" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsGenreText}"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="14" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsMultiplayerText}"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="14" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsCoOpText}"/>
            </StackPanel>
          </Grid>
          <StackPanel Name="GameDetailsInfoPanel" Width="310" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,188,94,0" w:Wpf.Visibility="{Binding IsGameDetailsOverviewTab, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <StackPanel Orientation="Horizontal">
              <Border Width="54" Height="70" Background="#E8FFFFFF" BorderBrush="#AAFFFFFF" BorderThickness="1" Margin="0,0,18,0">
                <TextBlock Foreground="#FF2D2D2D" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding SelectedGame.DetailsRatingLabel}"/>
              </Border>
              <TextBlock Foreground="#FFFFFFFF" FontSize="18" Width="215" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsRatingDescription}"/>
            </StackPanel>
            <TextBlock Text="Source" Foreground="#AAFFFFFF" FontSize="18" Margin="0,48,0,0"/>
            <TextBlock Foreground="#FFFFFFFF" FontSize="22" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsSourceText}"/>
            <TextBlock Text="Genre" Foreground="#AAFFFFFF" FontSize="18" Margin="0,26,0,0"/>
            <TextBlock Foreground="#FFFFFFFF" FontSize="22" TextWrapping="Wrap" Text="{Binding SelectedGame.DetailsGenreText}"/>
            <TextBlock Text="Last played" Foreground="#AAFFFFFF" FontSize="18" Margin="0,26,0,0"/>
            <TextBlock Foreground="#FFFFFFFF" FontSize="18" TextWrapping="Wrap" Text="{Binding SelectedGame.Game.LastPlayed}"/>
          </StackPanel>
          <Grid Name="GameDetailsDetailsPanel" Width="850" Height="370" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="198,188,0,0" w:Wpf.Visibility="{Binding IsGameDetailsDetailsTab, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="240"/>
              <ColumnDefinition Width="270"/>
              <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Developer" Foreground="#FFFFFFFF" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="20" Margin="0,5,0,28" TextWrapping="Wrap" Text="{Binding GameDetailsDeveloperText}"/>
              <TextBlock Text="Publisher" Foreground="#FFFFFFFF" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="20" Margin="0,5,0,28" TextWrapping="Wrap" Text="{Binding GameDetailsPublisherText}"/>
              <TextBlock Text="Genre" Foreground="#FFFFFFFF" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="20" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding GameDetailsGenreText}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="26,0,0,0">
              <TextBlock Text="Local Capabilities" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource MetroGreenBrush}"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="20" LineHeight="28" Margin="0,5,0,32" TextWrapping="Wrap" Text="{Binding GameDetailsLocalCapabilitiesText}"/>
              <TextBlock Text="Online Capabilities" Foreground="#FFE2B72C" FontSize="19" FontWeight="SemiBold"/>
              <TextBlock Foreground="#FFFFFFFF" FontSize="20" LineHeight="28" Margin="0,5,0,0" TextWrapping="Wrap" Text="{Binding GameDetailsOnlineCapabilitiesText}"/>
            </StackPanel>
            <TextBlock Grid.Column="2" Foreground="#FFFFFFFF" FontSize="21" LineHeight="30" TextWrapping="Wrap" Text="{Binding GameDetailsNoteText}"/>
          </Grid>
          <ItemsControl Name="GameDetailsExtrasPanel" Width="810" Height="312" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="228,184,0,0" ItemsSource="{Binding GameDetailsPreviewExtras}" w:Wpf.Visibility="{Binding IsGameDetailsExtrasTab, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <ItemsControl.RenderTransform>
              <TranslateTransform X="0"/>
            </ItemsControl.RenderTransform>
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="2" Rows="3"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="400" Height="100" Margin="2" Command="{Binding Command}" CommandParameter="{Binding}" Theme="{StaticResource GameDetailsExtraTileButtonStyle}">
                  <Grid>
                    <TextBlock Foreground="#E8FFFFFF" FontSize="18" Margin="108,0,0,0" Text="{Binding PriceText}"/>
                    <TextBlock Foreground="#E8FFFFFF" FontSize="17" HorizontalAlignment="Right" Margin="0,0,2,0" Text="{Binding RatingText}"/>
                    <Image Width="66" Height="66" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="23" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Width="278" TextAlignment="Center" Text="{Binding Title}"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Grid w:Wpf.Visibility="{Binding IsGameDetailsSeeAllOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Rectangle Fill="#AA1A1F12"/>
            <Rectangle IsHitTestVisible="False">
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#663D3400" Offset="0"/>
                  <GradientStop Color="#33000000" Offset="0.5"/>
                  <GradientStop Color="#AA000000" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <StackPanel Margin="100,104,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="⌄ sort by" Foreground="#D8FFFFFF" FontSize="20"/>
              <TextBlock Text="top downloads" Foreground="#D8FFFFFF" FontSize="25" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Light"/>
            </StackPanel>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,86,118,0">
              <TextBlock Foreground="#FFFFFFFF" FontSize="32" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Light" TextAlignment="Right" Text="{Binding SelectedGame.Title}"/>
              <TextBlock Foreground="#E0FFFFFF" FontSize="20" TextAlignment="Right" HorizontalAlignment="Right" Text="{Binding GameDetailsSeeAllCountText}"/>
            </StackPanel>
            <ItemsControl Width="1120" Height="330" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="84,178,0,0" ItemsSource="{Binding GameDetailsExtras}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Columns="3" Rows="3"/>
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Button Width="370" Height="104" Margin="2" Command="{Binding Command}" CommandParameter="{Binding}" Theme="{StaticResource GameDetailsExtraTileButtonStyle}">
                    <Grid>
                      <TextBlock Foreground="#E8FFFFFF" FontSize="18" Margin="110,0,0,0" Text="{Binding PriceText}"/>
                      <TextBlock Foreground="#E8FFFFFF" FontSize="17" HorizontalAlignment="Right" Text="{Binding RatingText}"/>
                      <Image Width="66" Height="66" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Center" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                      <TextBlock Foreground="#FFFFFFFF" FontSize="21" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Light" HorizontalAlignment="Center" VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Width="245" TextAlignment="Center" Text="{Binding Title}"/>
                    </Grid>
                  </Button>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Grid>
          <Grid Name="GameDetailsGalleryPanel" Width="880" Height="420" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="240,182,0,0" w:Wpf.Visibility="{Binding IsGameDetailsGalleryTab, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-74,-300,0">
              <TextBlock Foreground="#E0FFFFFF" FontSize="20" TextAlignment="Right" HorizontalAlignment="Right" Text="{Binding GameDetailsGalleryCountText}"/>
            </StackPanel>
            <Border Width="830" Height="426" Background="#66000000" ClipToBounds="True">
              <Image Name="GameDetailsGalleryImage" Stretch="UniformToFill" Source="{Binding GameDetailsGalleryImagePath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1280}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
            </Border>
          </Grid>
          <StackPanel Name="GameDetailsFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="95,0,0,38" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <Border Width="20" Height="20" CornerRadius="10" Background="{DynamicResource MetroGreenBrush}">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="16"/>
            <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back   " Foreground="#FFFFFFFF" FontSize="16" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
            <Border Width="20" Height="20" CornerRadius="10" Background="#FFE0C33C">
              <TextBlock Text="Y" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Pin to Tray" Foreground="#FFFFFFFF" FontSize="16"/>
          </StackPanel>
        </Grid>
        <Grid Background="#B0000000" w:Wpf.Visibility="{Binding IsSearchOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Width="760" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F0F4F6F4" BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="2" Padding="28">
            <StackPanel>
              <TextBlock Text="Bing" Foreground="#FF1A1C1B" FontSize="42" FontWeight="Light"/>
              <TextBlock Text="Search games, help, stores, and the web." Foreground="#FF4D5650" FontSize="17" Margin="0,0,0,18"/>
              <TextBox Name="SearchOverlayTextBox" Margin="0,0,0,16" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Theme="{StaticResource MetroTextBoxStyle}"/>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Search" Command="{Binding SubmitSearchCommand}" Theme="{StaticResource MetroActionButtonStyle}"/>
                <Button Content="Cancel" Margin="12,0,0,0" Command="{Binding CloseSearchCommand}" Theme="{StaticResource MetroActionButtonStyle}"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </Grid>
        <Border Width="360" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="70,0,0,0" Background="#ED101314" BorderBrush="#66FFFFFF" BorderThickness="1" Padding="24" w:Wpf.Visibility="{Binding IsQuickMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <StackPanel>
            <TextBlock Text="quick menu" Foreground="#AAFFFFFF" FontSize="18"/>
            <TextBlock Text="Options" Foreground="#FFFFFFFF" FontSize="38" FontWeight="Light" Margin="0,0,0,18"/>
            <Button Content="Add game" Command="{Binding AddGameCommand}" Theme="{StaticResource MetroActionButtonStyle}"/>
            <Button Content="Scan folder" Margin="0,10,0,0" Command="{Binding ScanFolderCommand}" Theme="{StaticResource MetroActionButtonStyle}"/>
            <Button Content="Settings" Margin="0,10,0,0" Command="{Binding OpenLauncherSettingsCommand}" Theme="{StaticResource MetroActionButtonStyle}"/>
          </StackPanel>
        </Border>
        <Grid Name="MyGamesOverlay" Background="#00FFFFFF" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsMyGamesOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Name="MyGamesBackdrop" Opacity="0.26" IsHitTestVisible="False">
            <Rectangle.Fill>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                <GradientStop Color="#FF303637" Offset="0"/>
                <GradientStop Color="#00FFFFFF" Offset="0.55"/>
                <GradientStop Color="#FFD9DDDC" Offset="1"/>
              </LinearGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <StackPanel Name="MyGamesFilterChrome" Orientation="Horizontal" Margin="80,50,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" w:Wpf.Visibility="{Binding IsLibraryShowingGameCovers, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <StackPanel Width="170">
            <TextBlock Text="⌄ show me" Foreground="#F2FFFFFF" FontSize="18"/>
              <TextBlock Foreground="#D8FFFFFF" FontSize="21" FontWeight="Light" Text="{Binding LibraryMenuFilterText}"/>
            </StackPanel>
            <StackPanel Width="170" Margin="36,0,0,0">
            <TextBlock Text="⌄ sort" Foreground="#F2FFFFFF" FontSize="18"/>
              <TextBlock Text="titles" Foreground="#D8FFFFFF" FontSize="21" FontWeight="Light"/>
            </StackPanel>
          </StackPanel>
          <StackPanel Name="MyGamesHeaderChrome" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,66,78,0" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <TextBlock Foreground="#FFFFFFFF" FontSize="30" FontWeight="Light" HorizontalAlignment="Right" Text="{Binding LibraryMenuTitle}"/>
            <TextBlock Foreground="#E8FFFFFF" FontSize="18" HorizontalAlignment="Right" Text="{Binding LibraryMenuCountText}"/>
            <TextBlock Foreground="#D8FFFFFF" FontSize="16" Width="260" Margin="0,8,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="40" TextAlignment="Right" HorizontalAlignment="Right" Text="{Binding LibraryMenuSelectedTitle}"/>
          </StackPanel>
          <ScrollViewer Name="MyGamesScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="61,134,0,0" Height="348" ClipToBounds="False" Focusable="False" RequestBringIntoView="MyGamesScrollViewer_OnRequestBringIntoView" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsLibraryShowingGameCovers, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid Name="MyGamesStrip" Width="2100" HorizontalAlignment="Left" ClipToBounds="False" RenderTransformOrigin="0%,0%">
              <Grid.RenderTransform>
                <TranslateTransform X="0"/>
              </Grid.RenderTransform>
              <ItemsControl Name="MyGamesItemsControl" ClipToBounds="False" Margin="14,0,0,0" ItemsSource="{Binding VisibleLibraryMenuGames}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" ClipToBounds="False"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Width="188" Height="327" Margin="0,0,8,0" Command="{Binding DataContext.LaunchGameCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource X360TileButtonStyle}">
                      <Grid Background="#F4F4F4">
                        <Border Width="188" Height="252" VerticalAlignment="Top" Background="#F4F4F4" BorderBrush="#F4F4F4" BorderThickness="1,1,1,0">
                          <Border Width="176" Height="238" Margin="6,5,6,9" HorizontalAlignment="Center" VerticalAlignment="Top" ClipToBounds="True" RenderOptions.BitmapInterpolationMode="HighQuality">
                            <Border.Background>
                              <MultiBinding Converter="{StaticResource GameCoverBrushConverter}">
                                <Binding Path="CoverArtPath"/>
                                <Binding Path="DataContext.GameCoverFitMode" RelativeSource="{RelativeSource AncestorType=Window}"/>
                                <Binding Path="CoverZoom"/>
                                <Binding Path="CoverOffsetX"/>
                                <Binding Path="CoverOffsetY"/>
                              </MultiBinding>
                            </Border.Background>
                          </Border>
                        </Border>
                        <Border Height="75" VerticalAlignment="Bottom" Background="#F4F4F4">
                          <Grid Margin="14,6,14,8">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="42"/>
                              <RowDefinition Height="*"/>
                              <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Foreground="#FF555555" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" LineHeight="18" Height="42" VerticalAlignment="Top" TextAlignment="Left" HorizontalAlignment="Stretch" Text="{Binding TileTitle}"/>
                            <TextBlock Grid.Row="2" Foreground="#FF777777" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Bottom" TextAlignment="Left" HorizontalAlignment="Stretch" Text="{Binding Subtitle}"/>
                          </Grid>
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </ScrollViewer>
          <ScrollViewer Name="MyAppsScrollViewer" Margin="92,172,0,0" Width="1070" Height="430" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" w:Wpf.Visibility="{Binding IsLibraryShowingApps, Converter={StaticResource BooleanToVisibilityConverter}}">
          <ItemsControl Name="MyAppsItemsControl" Width="{Binding AppLibraryCanvasWidth}" Height="430" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="False" ItemsSource="{Binding AppLibraryTiles}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <Canvas Width="{Binding DataContext.AppLibraryCanvasWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="430" ClipToBounds="False"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemContainerTheme>
              <ControlTheme TargetType="ContentPresenter">
                <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                <Setter Property="ZIndex" Value="{Binding ZIndex}"/>
              </ControlTheme>
            </ItemsControl.ItemContainerTheme>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Width="{Binding Width}" Height="{Binding Height}" Command="{Binding DataContext.LaunchAppLibraryTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource X360TileButtonStyle}" PointerEntered="AppLibraryTile_OnMouseEnter">
                  <Grid Background="{Binding TileBrush}" ClipToBounds="True">
                    <Image Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=256}" Width="{Binding Width}" Height="{Binding Height}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Glyph}" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="54" Foreground="{Binding ForegroundBrush}" Opacity="0.95" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,32" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding Title}" Foreground="{Binding ForegroundBrush}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" LineHeight="22" Margin="14,0,12,12" HorizontalAlignment="Left" VerticalAlignment="Bottom" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          <StackPanel Name="MyGamesFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="75,0,0,34" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Launch   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back   " Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF277DB8" w:Wpf.Visibility="{Binding HasLibraryMenuXHint, Converter={StaticResource BooleanToVisibilityConverter}}">
              <TextBlock Text="X" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Foreground="#FFFFFFFF" FontSize="15" Text="{Binding LibraryMenuXHintText}" w:Wpf.Visibility="{Binding HasLibraryMenuXHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <TextBlock Text="   " Foreground="#FFFFFFFF" FontSize="16" w:Wpf.Visibility="{Binding HasLibraryMenuXHint, Converter={StaticResource BooleanToVisibilityConverter}}"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFE0C33C">
              <TextBlock Text="Y" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Foreground="#FFFFFFFF" FontSize="15" Text="{Binding LibraryMenuYHintText}"/>
          </StackPanel>
        </Grid>
        <Grid Name="LauncherSettingsOverlay" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsLauncherSettingsOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.Theme>
            <ControlTheme TargetType="Grid">
              <Setter Property="Background" Value="#00FFFFFF"/>
              <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                  <w:Setter Property="Background">
                    <w:Setter.Value>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FF7C4AB8" Offset="0"/>
                        <GradientStop Color="#FFA16DDF" Offset="0.34"/>
                        <GradientStop Color="#FF7B49B4" Offset="1"/>
                      </LinearGradientBrush>
                    </w:Setter.Value>
                  </w:Setter>
                </w:DataTrigger></w:TriggerCollection></Template></Setter>
            </ControlTheme>
          </Grid.Theme>
          <Grid.Resources>
            <ResourceDictionary>
              
              
              <ControlTheme x:Key="SettingsCheckBoxStyle" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Foreground" Value="#FF333333"/>
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="Margin" Value="30,6,0,0"/>
                
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                    <w:Setter Property="Foreground" Value="{Binding BladesOverlayAccentBrush}"/>
                    <w:Setter Property="FontWeight" Value="SemiBold"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
              
              <ControlTheme x:Key="SystemSettingsCategoryTabStyle" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
                
                <Setter Property="Foreground" Value="#FF2E3336"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                      <Border Name="CategoryRoot" Width="285" Height="58" Background="#F4F7F8F8" BorderBrush="#44000000" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="TabItem.IsSelected" Value="True">
                          <w:Setter TargetName="CategoryRoot" Property="Border.Background" Value="{Binding BladesOverlayAccentBrush}"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </w:Trigger><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                          <w:Setter TargetName="CategoryRoot" Property="Border.BorderBrush" Value="#FFFFFFFF"/>
                          <w:Setter TargetName="CategoryRoot" Property="Border.BorderThickness" Value="2"/>
                        </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                          <w:Setter TargetName="CategoryRoot" Property="Border.Background" Value="#FFEAF0EA"/>
                        </w:Trigger><w:MultiTrigger>
                          <w:MultiTrigger.Conditions>
                            <w:Condition Property="UIElement.IsMouseOver" Value="True"/>
                            <w:Condition Property="TabItem.IsSelected" Value="True"/>
                          </w:MultiTrigger.Conditions>
                          <w:Setter TargetName="CategoryRoot" Property="Border.Background" Value="{Binding BladesOverlayAccentBrush}"/>
                        </w:MultiTrigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <TextBlock Text="{TemplateBinding Header}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" Margin="26,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                      </Border>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </ControlTheme>
              <ControlTheme x:Key="SystemSettingsOptionButtonStyle" TargetType="Button" BasedOn="{StaticResource SettingsActionButtonStyle}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="36"/>
                <Setter Property="Margin" Value="18,4,18,0"/>
                <Setter Property="Padding" Value="16,5"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="FontSize" Value="16"/>
                
                <Setter Property="w:WpfTriggers.ThemeTriggers2"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <w:Setter Property="BorderBrush" Value="#66000000"/>
                    <w:Setter Property="BorderThickness" Value="1"/>
                  </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <w:Setter Property="BorderBrush" Value="#66000000"/>
                    <w:Setter Property="BorderThickness" Value="1"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
              <ControlTheme x:Key="SystemSettingsMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Padding" Value="32,0,14,0"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Foreground" Value="#FF2E3336"/>
                <Setter Property="Background" Value="#F4F7F8F8"/>
                <Setter Property="BorderBrush" Value="#44000000"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="FontSize" Value="21"/>
                
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                          <w:Setter TargetName="Highlight" Property="UIElement.Opacity" Value="1"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                          <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#44000000"/>
                          <w:Setter TargetName="Root" Property="Border.BorderThickness" Value="0,0,0,1"/>
                        </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                          <w:Setter TargetName="Highlight" Property="UIElement.Opacity" Value="1"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                          <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#44000000"/>
                          <w:Setter TargetName="Root" Property="Border.BorderThickness" Value="0,0,0,1"/>
                        </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                          <w:Setter TargetName="Highlight" Property="UIElement.Opacity" Value="1"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <Grid>
                          <Border Name="Highlight" Opacity="0" Background="{Binding BladesOverlayAccentBrush}"/>
                          <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                        </Grid>
                      </Border>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </ControlTheme>
            </ResourceDictionary>
          </Grid.Resources><Grid.Styles><Style Selector="ComboBox">
                <Setter Property="FontSize" Value="18"/>
                
                <Setter Property="BorderBrush" Value="#66999999"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="w:WpfTriggers.StyleTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                    <w:Setter Property="BorderBrush" Value="{Binding BladesOverlayAccentBrush}"/>
                    <w:Setter Property="BorderThickness" Value="3"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </Style><Style Selector="TextBox">
                <Setter Property="Foreground" Value="#FF1D1D1D"/>
                <Setter Property="Background" Value="#EEFFFFFF"/>
                <Setter Property="BorderBrush" Value="#88999999"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="FontSize" Value="22"/>
                <Setter Property="Padding" Value="10,6"/>
                <Setter Property="CaretBrush" Value="{Binding BladesOverlayAccentBrush}"/>
                
                <Setter Property="w:WpfTriggers.StyleTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                    <w:Setter Property="BorderBrush" Value="{Binding BladesOverlayAccentBrush}"/>
                    <w:Setter Property="BorderThickness" Value="3"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </Style><Style Selector="Slider">
                
                <Setter Property="w:WpfTriggers.StyleTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                    <w:Setter Property="Foreground" Value="{Binding BladesOverlayAccentBrush}"/>
                  </w:Trigger></w:TriggerCollection></Template></Setter>
              </Style></Grid.Styles>
          <TextBlock Name="SettingsHeaderTitle" Text="System Settings" Foreground="#FFFFFFFF" FontSize="32" FontWeight="SemiBold" Margin="138,62,0,0" RenderTransformOrigin="0%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform X="0"/>
            </TextBlock.RenderTransform>
          </TextBlock>
            <Grid Name="SettingsPanelFrame" Width="884" Height="482" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="442"/>
              <ColumnDefinition Width="442"/>
            </Grid.ColumnDefinitions>
            <Border Background="#EEF3F5F5"/>
            <Border Grid.Column="1" Background="#D95F6668"/>
            <StackPanel Name="SystemSettingsCategoryPanel">
              <Button Content="Console Settings" Tag="console|Console Settings|Change startup, controller, sound, and launch behavior." Click="SettingsCategory_OnClick" Theme="{StaticResource SystemSettingsMenuButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Dashboard Customization" Tag="dashboard|Dashboard Customization|Change themes, dashboard tile images, tile text, and tile color." Click="SettingsCategory_OnClick" Theme="{StaticResource SystemSettingsMenuButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Games Setup" Tag="games|Games Setup|Add games, scan Steam, edit artwork, and choose how game tiles appear." Click="SettingsCategory_OnClick" Theme="{StaticResource SystemSettingsMenuButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Audio" Tag="audio|Audio|Choose sound behavior and open the music folder." Click="SettingsCategory_OnClick" Theme="{StaticResource SystemSettingsMenuButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Data Control" Tag="data|Data Control|Import or export your dashboard library, profile, and settings data." Click="SettingsCategory_OnClick" Theme="{StaticResource SystemSettingsMenuButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
            </StackPanel>
            <ScrollViewer Name="SystemSettingsConsolePanel" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="Collapsed">
              <StackPanel Margin="0,0,0,18">
                <ComboBox Height="42" Margin="30,12,30,8" Tag="Display Aspect Ratio|Choose the dashboard window shape." ItemsSource="{Binding ResolutionOptions}" SelectedItem="{Binding Settings.DisplayResolution, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="Dashboard Style" Foreground="#FF333333" FontSize="15" Margin="30,2,30,0"/>
                <ComboBox Height="42" Margin="30,4,30,8" Tag="Dashboard Style|Choose Metro or the classic Blades dashboard shell." ItemsSource="{Binding DashboardStyleOptions}" SelectedItem="{Binding Settings.DashboardStyle, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="Xbox Guide" Foreground="#FF333333" FontSize="15" Margin="30,2,30,0"/>
                <ComboBox Height="42" Margin="30,4,30,8" Tag="Xbox Guide|Choose Metro or Blades independently of Dashboard Style." ItemsSource="{Binding XboxGuideOptions}" SelectedItem="{Binding Settings.XboxGuide, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="Dashboard Sounds" Foreground="#FF333333" FontSize="15" Margin="30,2,30,0"/>
                <ComboBox Height="42" Margin="30,4,30,8" Tag="Dashboard Sounds|Choose which dashboard sound set plays for navigation." ItemsSource="{Binding DashboardSoundOptions}" SelectedItem="{Binding Settings.DashboardSounds, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="Dashboard Startup" Foreground="#FF333333" FontSize="15" Margin="30,2,30,0"/>
                <ComboBox Height="42" Margin="30,4,30,8" Tag="Dashboard Startup|Choose which startup intro plays when the dashboard opens." ItemsSource="{Binding DashboardStartupOptions}" SelectedItem="{Binding Settings.DashboardStartup, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Start Fullscreen" Tag="Start Fullscreen|Open the dashboard in fullscreen mode." IsChecked="{Binding Settings.StartFullscreen}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Play UI Sounds" Tag="Play UI Sounds|Play dashboard navigation and selection sounds." IsChecked="{Binding Settings.PlayUiSounds}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Enable Controller Input" Tag="Enable Controller Input|Use an Xbox-compatible controller to navigate the dashboard." IsChecked="{Binding Settings.EnableControllerInput}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Launch on Windows Startup" Tag="Launch on Windows Startup|Start this dashboard automatically when Windows signs in." IsChecked="{Binding Settings.LaunchOnWindowsStartup}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Minimize on Game Launch" Tag="Minimize on Game Launch|Hide the dashboard while a selected game is running." IsChecked="{Binding Settings.MinimizeOnGameLaunch}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <CheckBox Content="Enable Fake Loading" Tag="Enable Fake Loading|Show the Xbox-style loading transition during startup." IsChecked="{Binding Settings.EnableFakeLoading}" Theme="{StaticResource SettingsCheckBoxStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Save Settings" Tag="Save Settings|Save the current console and dashboard settings." Command="{Binding SaveSettingsCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer Name="SystemSettingsDashboardPanel" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" KeyboardNavigation.IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="Collapsed">
              <StackPanel Margin="0,0,0,18">
                <Button Content="Create Theme" Tag="Create Theme|Create a full dashboard theme with custom section backgrounds." Command="{Binding OpenThemeCreatorCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Customize Tiles" Tag="Customize Tiles|Change dashboard tile images, tile text, and the global tile color." Command="{Binding OpenDashboardCustomizerCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              </StackPanel>
            </ScrollViewer>
            <ScrollViewer Name="SystemSettingsGamesPanel" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="Collapsed">
              <StackPanel Margin="0,0,0,18">
                <TextBlock Text="Add items to" Foreground="#FF333333" FontSize="15" Margin="30,12,30,0"/>
                <ComboBox Height="38" Margin="30,4,30,7" Tag="Add Items To|Choose where newly added games or apps should appear." ItemsSource="{Binding AddDestinationOptions}" SelectedItem="{Binding DefaultAddDestination, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Scan Steam Games" Tag="Scan Steam Games|Find installed Steam games and add them to the dashboard." Command="{Binding ScanSteamGamesCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Steam Setup" Tag="Steam Setup|Configure Steam Web API and profile details for richer game metadata." Command="{Binding OpenSteamSetupCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Add Executable" Tag="Add Executable|Add a local game or app executable manually." Command="{Binding AddGameCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="{Binding SetupItemLabel}" Foreground="#FF333333" FontSize="15" Margin="30,10,30,0"/>
                <ComboBox Height="38" Margin="30,4,30,7" Tag="{Binding SetupItemTag}" ItemsSource="{Binding SetupEditableItems}" SelectedItem="{Binding SelectedGame, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" DisplayMemberBinding="{Binding Title}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBox Margin="30,4,30,7" Tag="Selected Game / Save Name|Edit the selected game's dashboard display name, then choose Save Name." Text="{Binding SelectedGame.Game.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Save Name" Tag="Save Name|Save the edited display name for the selected game." Command="{Binding SaveSelectedGameCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Edit Executable" Tag="Edit Executable|Change the executable path for the selected game." Command="{Binding EditSelectedGameCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Remove" Tag="Remove|Remove the selected game from the dashboard library." Command="{Binding RemoveSelectedGameCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Show On Open Tray" Tag="Show On Open Tray|Use the selected game as the Open Tray launch tile." Command="{Binding SetOpenTrayGameCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Choose Home Screen Image" Tag="Choose Home Screen Image|Set the selected game's large Home dashboard image." Command="{Binding ChooseSelectedHomeImageCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <Button Content="Choose My Games/App Image" Tag="Choose My Games/App Image|Set the image used for this item in the library view." Command="{Binding ChooseSelectedGameMenuImageCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="{Binding SetupCoverFitLabel}" Foreground="#FF333333" FontSize="15" Margin="30,10,30,0"/>
                <ComboBox Height="38" Margin="30,4,30,7" Tag="{Binding SetupCoverFitTag}" ItemsSource="{Binding GameCoverFitOptions}" SelectedItem="{Binding GameCoverFitMode, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
                <TextBlock Text="Cover Preview Editor" Foreground="#FF333333" FontSize="15" Margin="30,10,30,0"/>
                <Grid Margin="30,6,30,0" Tag="Cover Preview Editor|Adjust zoom and crop for the selected game's cover art." GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="94"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Width="{Binding SelectedCoverPreviewWidth}" Height="{Binding SelectedCoverPreviewHeight}" ClipToBounds="True" HorizontalAlignment="Left">
                    <Border.Background>
                      <MultiBinding Converter="{StaticResource GameCoverBrushConverter}">
                        <Binding Path="SelectedGame.CoverArtPath"/>
                        <Binding Path="GameCoverFitMode"/>
                        <Binding Path="SelectedCoverZoom"/>
                        <Binding Path="SelectedCoverOffsetX"/>
                        <Binding Path="SelectedCoverOffsetY"/>
                      </MultiBinding>
                    </Border.Background>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="Zoom" Foreground="#FF333333" FontSize="12"/>
                    <Slider Minimum="1" Maximum="1.8" Value="{Binding SelectedCoverZoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="Move left / right" Foreground="#FF333333" FontSize="12"/>
                    <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedCoverOffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="Move up / down" Foreground="#FF333333" FontSize="12"/>
                    <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedCoverOffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <Button Content="Reset Cover Fit" Margin="0,8,0,0" Command="{Binding ResetSelectedCoverTransformCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </ScrollViewer>
            <StackPanel Name="SystemSettingsAudioPanel" w:Wpf.Visibility="Collapsed">
              <TextBlock Text="Output Device Select" Foreground="#FF333333" FontSize="15" Margin="30,12,30,0"/>
              <ComboBox Height="38" Margin="30,4,30,7" Tag="Output Device Select|Choose which Windows audio output device should play dashboard sounds." ItemsSource="{Binding AudioOutputDeviceOptions}" SelectedItem="{Binding AudioOutputDeviceName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectionChanged="AudioOutputDeviceComboBox_OnSelectionChanged" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Music Files" Tag="Music Files|Open the local music folder so you can add or remove dashboard music files." Command="{Binding OpenMusicFolderCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <TextBlock Text="Dashboard Volume" Foreground="#FF333333" FontSize="15" Margin="30,18,30,0"/>
              <Grid Margin="30,6,30,0" Tag="Dashboard Volume|Change only this dashboard's sounds and music volume." GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="62"/>
                </Grid.ColumnDefinitions>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.05" IsSnapToTickEnabled="True" Value="{Binding DashboardVolume, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                <TextBlock Grid.Column="1" Foreground="#FF333333" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding DashboardVolumeText}"/>
              </Grid>
            </StackPanel>
            <StackPanel Name="SystemSettingsDataPanel" w:Wpf.Visibility="Collapsed">
              <Button Content="Import Data" Tag="Import Data|Restore dashboard data from a previously exported backup file." Command="{Binding ImportDataCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
              <Button Content="Export Data" Tag="Export Data|Create a portable backup of your library, settings, and profile." Command="{Binding ExportDataCommand}" Theme="{StaticResource SystemSettingsOptionButtonStyle}" GotFocus="SettingsOption_OnFocusOrMouseEnter" PointerEntered="SettingsOption_OnFocusOrMouseEnter"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Margin="30,30,40,0">
              <TextBlock Name="SettingsDescriptionTitle" Text="Console Settings" Foreground="#FFFFFFFF" FontSize="26" FontWeight="Light" TextWrapping="Wrap"/>
              <TextBlock Name="SettingsDescriptionText" Text="Change startup, controller, sound, and launch behavior." Foreground="#E8FFFFFF" FontSize="22" Margin="0,18,0,0" LineHeight="34" TextWrapping="Wrap"/>
            </StackPanel>
          </Grid>
          <StackPanel Name="SettingsFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
          </StackPanel>
        </Grid>
        <Grid Name="ThemeMenuOverlay" Focusable="False" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsThemeMenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle x:Name="ThemeMenuBackdrop" Fill="#88000000"/>
          <Border x:Name="ThemeMenuPanel" Width="420" Height="430" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="182,120,0,0" Background="#F6F7F7F7" BorderBrush="#66FFFFFF" BorderThickness="1" RenderTransformOrigin="0%,0%">
            <Border.RenderTransform>
              <TranslateTransform X="0"/>
            </Border.RenderTransform>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="68"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Background="#FDFDFD">
                <TextBlock Text="Select Theme" Foreground="#FF666666" FontSize="25" Margin="24,0,0,0" VerticalAlignment="Center"/>
              </Border>
              <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" KeyboardNavigation.IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding AvailableThemes}" Focusable="False" KeyboardNavigation.IsTabStop="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Height="58" FontSize="24" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Background="#FFF4F4F4" BorderBrush="#FFD5D5D5" BorderThickness="0" Padding="0" Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Content="{Binding Name}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Button.Theme>
                          <ControlTheme TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                            
                            
                            <Setter Property="Foreground" Value="#FF2B2B2B"/>
                            <Setter Property="Template">
                              <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                  <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsFocused" Value="True">
                                      <w:Setter TargetName="Root" Property="Border.Background" Value="{Binding BladesOverlayAccentBrush}"/>
                                      <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                                    </w:Trigger><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                                      <w:Setter TargetName="Root" Property="Border.Background" Value="{Binding BladesOverlayAccentBrush}"/>
                                      <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                                    </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                                      <w:Setter TargetName="Root" Property="Border.Background" Value="{Binding BladesOverlayAccentBrush}"/>
                                      <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                                    </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                                    <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Margin="24,0,0,0" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                                  </Border>
                                  
                                </ControlTemplate>
                              </Setter.Value>
                            </Setter>
                          </ControlTheme>
                        </Button.Theme>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </Grid>
          </Border>
          <StackPanel x:Name="ThemeMenuFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
          </StackPanel>
        </Grid>
        <Grid Name="DashboardCustomizerOverlay" Focusable="False" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsDashboardCustomizerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Fill="#77000000"/>
          <Border Width="1060" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#EDE8ECEC" BorderBrush="#CCFFFFFF" BorderThickness="1">
            <Grid Margin="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="720"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel Grid.ColumnSpan="3" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="DashboardCustomizerPreviousTabButton" Width="44" Height="36" Padding="0" Command="{Binding PreviousDashboardCustomizerTabCommand}" Theme="{StaticResource SettingsActionButtonStyle}">
                  <TextBlock Text="&lt;" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="26" FontWeight="SemiBold" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Button>
                <TextBlock Foreground="#FF333333" FontSize="30" FontWeight="Light" Margin="16,0" VerticalAlignment="Center" Text="{Binding CurrentDashboardCustomizationTabName}"/>
                <Button x:Name="DashboardCustomizerNextTabButton" Width="44" Height="36" Padding="0" Command="{Binding NextDashboardCustomizerTabCommand}" Theme="{StaticResource SettingsActionButtonStyle}">
                  <TextBlock Text="&gt;" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="26" FontWeight="SemiBold" LineHeight="26" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
                </Button>
                <TextBlock Text="Customize Dashboard" Foreground="#AA333333" FontSize="18" Margin="22,8,0,0"/>
              </StackPanel>
              <Border Grid.Row="1" Width="690" Height="360" Margin="0,22,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FF5F6668" ClipToBounds="False">
                <Viewbox Stretch="Uniform" ClipToBounds="False">
                  <Canvas Width="806" Height="368" ClipToBounds="False">
                    <ItemsControl ClipToBounds="False" ItemsSource="{Binding CurrentDashboardCustomizationTab.Tiles}" Canvas.Left="{Binding CurrentDashboardCustomizationTab.ContentMargin.Left}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <Canvas Width="806" Height="368" ClipToBounds="False"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemContainerTheme>
                        <ControlTheme TargetType="ContentPresenter">
                          <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                          <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                          <Setter Property="ZIndex" Value="1"/>
                        </ControlTheme>
                      </ItemsControl.ItemContainerTheme>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Width="{Binding Width}" Height="{Binding Height}" Command="{Binding DataContext.SelectDashboardTileCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource X360TileButtonStyle}">
                            <Grid ClipToBounds="True">
                              <Border Background="{DynamicResource MetroGreenBrush}"/>
                              <Border Background="{Binding PlaceholderBrush}"/>
                              <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality">
                                <Image.Source>
                                  <MultiBinding Converter="{StaticResource DashboardTilePreviewImageSourceConverter}">
                                    <Binding Path="ImagePath"/>
                                    <Binding Path="Zoom"/>
                                    <Binding Path="OffsetX"/>
                                    <Binding Path="OffsetY"/>
                                    <Binding Path="DefaultImagePath"/>
                                  </MultiBinding>
                                </Image.Source>
                              </Image>
                              <Rectangle VerticalAlignment="Bottom" Fill="#99000000">
                                <Rectangle.Theme>
                                  <ControlTheme TargetType="Rectangle">
                                    <Setter Property="Height" Value="30"/>
                                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding AllowsSecondaryTitleCustomization}" Value="True">
                                        <w:Setter Property="Height" Value="44"/>
                                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                                  </ControlTheme>
                                </Rectangle.Theme>
                              </Rectangle>
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="{Binding TitleFontSize}" Margin="{Binding TitleMargin}">
                                <TextBlock.Theme>
                                  <ControlTheme TargetType="TextBlock">
                                    <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding AllowsSecondaryTitleCustomization}" Value="True">
                                        <w:Setter Property="Visibility" Value="Collapsed"/>
                                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                                  </ControlTheme>
                                </TextBlock.Theme>
                              </TextBlock>
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding TitleBrush}" FontSize="{Binding TitleFontSize}" Margin="8,0,8,23" w:Wpf.Visibility="{Binding AllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                              <TextBlock VerticalAlignment="Bottom" TextTrimming="CharacterEllipsis" Text="{Binding SecondaryTitle}" Foreground="#DFFFFFFF" FontSize="{Binding TitleFontSize}" Margin="8,0,8,7" w:Wpf.Visibility="{Binding AllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                              <Border BorderBrush="#F2FFFFFF" BorderThickness="3" Opacity="0">
                                <Border.Theme>
                                  <ControlTheme TargetType="Border">
                                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                                        <w:Setter Property="UIElement.Opacity" Value="1"/>
                                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                                  </ControlTheme>
                                </Border.Theme>
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Canvas>
                </Viewbox>
              </Border>
              <ScrollViewer Grid.Row="1" Grid.Column="2" Margin="0,18,0,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ZIndex="20">
                <StackPanel>
                  <TextBlock Foreground="#FF333333" FontSize="23" FontWeight="Light" Margin="0,0,0,6" Text="{Binding SelectedDashboardTileTitle}"/>
                  <TextBlock Foreground="#AA333333" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,12" Text="{Binding SelectedDashboardTileCustomizationHint}"/>
                  <Border Background="#DDE6E9E9" BorderBrush="#88FFFFFF" BorderThickness="1" Padding="10,9,10,10" Margin="0,0,0,14">
                    <StackPanel>
                      <TextBlock Text="Tile labels" Foreground="#88333333" FontSize="15" Margin="0,0,0,8"/>
                      <TextBlock Text="Tile Text" Foreground="#FF333333" FontSize="16"/>
                      <TextBox Height="36" FontSize="18" Margin="0,4,0,9" Padding="10,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                      <StackPanel w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsSecondaryTitleCustomization, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="2nd Tile Text" Foreground="#FF333333" FontSize="16"/>
                        <TextBox Height="36" FontSize="18" Margin="0,4,0,0" Padding="10,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.SecondaryTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                      </StackPanel>
                      <StackPanel w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsLaunchCustomization, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Executable" Foreground="#FF333333" FontSize="16" Margin="0,10,0,0"/>
                        <Grid Height="36" Margin="0,4,0,9">
                          <TextBox FontSize="14" Padding="10,5,48,4" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.LaunchExecutablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                          <Button Content="..." Width="44" HorizontalAlignment="Right" Padding="0" Command="{Binding ChooseDashboardTileExecutableCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                        </Grid>
                        <TextBlock Text="Web Address" Foreground="#FF333333" FontSize="16"/>
                        <TextBox Height="36" FontSize="14" Margin="0,4,0,0" Padding="10,5" BorderBrush="#AAC8C8C8" BorderThickness="1" Background="#F9FFFFFF" Foreground="#FF222222" Text="{Binding SelectedDashboardTile.LaunchWebAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Button Content="Reset Text" Margin="0,0,0,14" Command="{Binding ResetDashboardTileTitleCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                  <Button Content="Choose Image" Command="{Binding ChooseDashboardTileImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Button Content="Reset Image" Margin="0,8,0,14" Command="{Binding ResetDashboardTileImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <TextBlock Text="Zoom" Foreground="#FF333333" FontSize="16" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Slider Minimum="1" Maximum="2.5" Value="{Binding SelectedDashboardTile.Zoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <TextBlock Text="Horizontal crop" Foreground="#FF333333" FontSize="16" Margin="0,8,0,0" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedDashboardTile.OffsetX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <TextBlock Text="Vertical crop" Foreground="#FF333333" FontSize="16" Margin="0,8,0,0" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <Slider Minimum="-1" Maximum="1" Value="{Binding SelectedDashboardTile.OffsetY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding SelectedDashboardTileAllowsImageCustomization, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                  <StackPanel w:Wpf.Visibility="{Binding SelectedDashboardTileUsesDashboardColor, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Button Content="Tile Color" Margin="0,20,0,8" Command="{Binding OpenDashboardTileColorPickerCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                    <Border Height="32" BorderBrush="#99FFFFFF" BorderThickness="1" Margin="0,0,0,8" Background="{Binding DashboardTileColorPreviewBrush}"/>
                    <TextBlock Text="Red" Foreground="#FF333333" FontSize="14"/>
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileRed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="Green" Foreground="#FF333333" FontSize="14"/>
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileGreen, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    <TextBlock Text="Blue" Foreground="#FF333333" FontSize="14"/>
                    <Slider Minimum="0" Maximum="255" Value="{Binding CustomTileBlue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  </StackPanel>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" ZIndex="20" Margin="0,14,0,0">
                <Button Content="Reset Tab" Command="{Binding ResetDashboardTabImagesCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                <Button Content="Reset Color" Margin="10,0,0,0" Command="{Binding ResetDashboardTileColorCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                <Button Content="Back" Margin="10,0,0,0" Command="{Binding CloseDashboardCustomizerCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
        <Grid Name="ThemeCreatorOverlay" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsThemeCreatorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Fill="#77000000"/>
          <Border Width="980" Height="540" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F4F4F4" BorderBrush="#88FFFFFF" BorderThickness="1">
            <Grid Margin="24">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="1*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <TextBlock Text="Create Theme" Foreground="#FF333333" FontSize="28" FontWeight="SemiBold" Grid.ColumnSpan="2"/>
              <ScrollViewer Grid.Row="1" Margin="0,20,24,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="Theme name" Foreground="#FF333333" FontSize="18"/>
                  <TextBox Margin="0,8,0,14" Text="{Binding ThemeNameInput, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  <TextBlock Text="1. Choose Home background" Foreground="#FF333333" FontSize="18"/>
                  <Button Name="ChooseThemeHomeBackgroundButton" Content="Choose Home background" Margin="0,8,0,14" Command="{Binding ChooseThemeHomeImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                  <TextBlock Text="2. Choose My Games/My Pins background" Foreground="#FF333333" FontSize="18"/>
                  <Button Content="Choose My Games/My Pins background" Margin="0,8,0,14" Command="{Binding ChooseThemeGamesImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                  <TextBlock Text="3. Choose Settings background" Foreground="#FF333333" FontSize="18"/>
                  <Button Content="Choose Settings background" Margin="0,8,0,14" Command="{Binding ChooseThemeSettingsImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                  <TextBlock Text="4. Choose Apps/My Apps background" Foreground="#FF333333" FontSize="18"/>
                  <Button Content="Choose Apps/My Apps background" Margin="0,8,0,12" Command="{Binding ChooseThemeAppsImageCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                </StackPanel>
              </ScrollViewer>
              <Grid Row="1" Column="1" Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Margin="10">
                  <TextBlock Text="Home preview" Foreground="#FF333333" FontSize="18" Margin="0,0,0,8"/>
                  <Border Height="170" Background="#FF9A9A9A" BorderBrush="#99FFFFFF" BorderThickness="1">
                    <Image Stretch="UniformToFill" Source="{Binding ThemeHomePreviewPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=640}"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="10">
                  <TextBlock Text="My Games/My Pins preview" Foreground="#FF333333" FontSize="18" Margin="0,0,0,8"/>
                  <Border Height="170" Background="#FF9A9A9A" BorderBrush="#99FFFFFF" BorderThickness="1">
                    <Image Stretch="UniformToFill" Source="{Binding ThemeGamesPreviewPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=640}"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="10">
                  <TextBlock Text="Settings preview" Foreground="#FF333333" FontSize="18" Margin="0,0,0,8"/>
                  <Border Height="170" Background="#FF9A9A9A" BorderBrush="#99FFFFFF" BorderThickness="1">
                    <Image Stretch="UniformToFill" Source="{Binding ThemeSettingsPreviewPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=640}"/>
                  </Border>
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="10">
                  <TextBlock Text="Apps/My Apps preview" Foreground="#FF333333" FontSize="18" Margin="0,0,0,8"/>
                  <Border Height="170" Background="#FF9A9A9A" BorderBrush="#99FFFFFF" BorderThickness="1">
                    <Image Stretch="UniformToFill" Source="{Binding ThemeAppsPreviewPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=640}"/>
                  </Border>
                </StackPanel>
              </Grid>
              <StackPanel Grid.Row="2" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Save Theme" Width="180" Margin="0,0,10,0" Command="{Binding SaveThemeCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                <Button Content="Back" Width="140" Command="{Binding CloseThemeCreatorCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45">
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
          </StackPanel>
        </Grid>
        <Grid Name="SteamSetupOverlay" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsSteamSetupOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Rectangle Fill="#77000000"/>
          <Border Width="760" Height="500" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#F1F4F4F4" BorderBrush="#88FFFFFF" BorderThickness="1">
            <Grid Margin="26">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>
              <StackPanel>
                <TextBlock Text="Steam Setup" Foreground="#FF333333" FontSize="30" FontWeight="SemiBold"/>
                <TextBlock Text="Connect Steam friends and Guide achievements. This saves only to this app copy's UserData folder." Foreground="#FF555555" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
              <ScrollViewer Grid.Row="1" Margin="0,22,0,0" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel>
                  <TextBlock Text="SteamID64" Foreground="#FF333333" FontSize="18"/>
                  <DockPanel Margin="0,8,0,16">
                    <Button Content="Paste" Width="110" Margin="10,0,0,0" DockPanel.Dock="Right" Command="{Binding PasteSteamIdCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                    <TextBox Height="42" FontSize="20" VerticalContentAlignment="Center" Text="{Binding SteamSetupSteamId64, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  </DockPanel>
                  <TextBlock Text="Steam Web API key" Foreground="#FF333333" FontSize="18"/>
                  <DockPanel Margin="0,8,0,16">
                    <Button Content="Paste" Width="110" Margin="10,0,0,0" DockPanel.Dock="Right" Command="{Binding PasteSteamApiKeyCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                    <TextBox Height="42" FontSize="20" VerticalContentAlignment="Center" Text="{Binding SteamSetupApiKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                  </DockPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                    <Button Content="Get API Key" Width="170" Margin="0,0,10,0" Command="{Binding OpenSteamApiKeyPageCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                    <Button Content="Find SteamID64" Width="180" Command="{Binding OpenSteamProfileHelpCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                  </StackPanel>
                  <Border Background="#22FFFFFF" BorderBrush="#55FFFFFF" BorderThickness="1" Padding="14" Margin="0,0,0,8">
                    <TextBlock Foreground="#FF333333" FontSize="17" TextWrapping="Wrap" Text="{Binding SteamSetupStatus}"/>
                  </Border>
                </StackPanel>
              </ScrollViewer>
              <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="Test Connection" Width="190" Margin="0,0,10,0" Command="{Binding TestSteamSetupCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                <Button Content="Save" Width="140" Margin="0,0,10,0" Command="{Binding SaveSteamSetupCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
                <Button Content="Back" Width="130" Command="{Binding CloseSteamSetupCommand}" Theme="{StaticResource SettingsActionButtonStyle}"/>
              </StackPanel>
            </Grid>
          </Border>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Margin="92,0,0,45">
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
          </StackPanel>
        </Grid>
        <Grid Name="MusicPlayerOverlay" KeyboardNavigation.TabNavigation="Cycle" w:Wpf.Visibility="{Binding IsMusicPlayerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.Resources>
            <ResourceDictionary>
              <ControlTheme x:Key="MusicPlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Foreground" Value="#FF333333"/>
                <Setter Property="Background" Value="#FFE8ECEC"/>
                <Setter Property="BorderBrush" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="1"/>
                
                <Setter Property="FontSize" Value="17"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Padding" Value="4,0"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                          <w:Setter Property="BorderThickness" Value="2"/>
                          <w:Setter TargetName="Root" Property="UIElement.Effect">
                            <w:Setter.Value>
                              <DropShadowEffect BlurRadius="14" Color="White" Opacity="0.35" OffsetX="0" OffsetY="0"/>
                            </w:Setter.Value>
                          </w:Setter>
                        </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="BorderBrush" Value="#FFFFFFFF"/>
                          <w:Setter Property="BorderThickness" Value="2"/>
                        </w:Trigger><w:Trigger Property="Tag" Value="True">
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="BorderBrush" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                        </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                          <w:Setter Property="Background" Value="{w:DynRes MetroGreenDarkBrush}"/>
                        </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                      </Border>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </ControlTheme>
              <ControlTheme x:Key="MusicTrackButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#00FFFFFF"/>
                
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Grid><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                          <w:Setter TargetName="FocusFrame" Property="UIElement.Opacity" Value="1"/>
                          <w:Setter Property="Panel.ZIndex" Value="10"/>
                        </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                          <w:Setter Property="UIElement.Opacity" Value="0.82"/>
                        </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                        <Border Name="FocusFrame" BorderBrush="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" BorderThickness="4" Opacity="0"/>
                      </Grid>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </ControlTheme>
              <ControlTheme x:Key="MusicBrowserMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="#E6EEF1F1"/>
                <Setter Property="Foreground" Value="#FF30383A"/>
                
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </w:DataTrigger><w:Trigger Property="UIElement.IsKeyboardFocusWithin" Value="True">
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                          <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                          <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                        </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                          <w:Setter Property="Background" Value="{w:DynRes MetroGreenDarkBrush}"/>
                        </w:Trigger><w:Trigger Property="IsEnabled" Value="False">
                          <w:Setter Property="Background" Value="#DDE8ECEC"/>
                          <w:Setter Property="Foreground" Value="#FF8A9295"/>
                        </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                      </Border>
                      
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </ControlTheme>
            </ResourceDictionary>
          </Grid.Resources>
          <Grid.Theme>
            <ControlTheme TargetType="Grid">
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#F0060708" Offset="0"/>
                    <GradientStop Color="#EA161A1C" Offset="0.55"/>
                    <GradientStop Color="#F0020203" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                  <w:Setter Property="Background">
                    <w:Setter.Value>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#FF227FBA" Offset="0"/>
                        <GradientStop Color="#FF35A2DC" Offset="0.36"/>
                        <GradientStop Color="#FF1F77AF" Offset="1"/>
                      </LinearGradientBrush>
                    </w:Setter.Value>
                  </w:Setter>
                </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding IsMusicPlayerTransparent}">
                  <w:Setter Property="Background" Value="#00FFFFFF"/>
                </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                  <w:Setter Property="Background" Value="#F4000000"/>
                </w:DataTrigger></w:TriggerCollection></Template></Setter>
            </ControlTheme>
          </Grid.Theme>
          <TextBlock Name="MusicPlayerHeader" Text="{Binding MusicPlayerHeaderText}" Foreground="#F2FFFFFF" FontSize="32" FontWeight="Light" Margin="148,52,0,0" RenderTransformOrigin="0%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform X="0"/>
            </TextBlock.RenderTransform>
            <TextBlock.Theme>
              <ControlTheme TargetType="TextBlock">
                <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                    <w:Setter Property="Visibility" Value="Collapsed"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </TextBlock.Theme>
          </TextBlock>
          <Grid Name="MusicPlayerContentGrid" Width="880" Height="482" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform X="0"/>
            </Grid.RenderTransform>
            <Grid.Theme>
              <ControlTheme TargetType="Grid">
                <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                    <w:Setter Property="Visibility" Value="Collapsed"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </Grid.Theme>
            <Grid w:Wpf.Visibility="{Binding IsMusicBrowserVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="440"/>
              </Grid.ColumnDefinitions>
              <Border Background="#EEF0F2F1">
                <Border.Theme>
                  <ControlTheme TargetType="Border">
                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsMusicSourceBrowser}" Value="True">
                        <w:Setter Property="Grid.ColumnSpan" Value="2"/>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </Border.Theme>
              </Border>
              <Border Grid.Column="1" Background="#D9AEB4B7">
                <Border.Theme>
                  <ControlTheme TargetType="Border">
                    <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsMusicSourceBrowser}" Value="True">
                        <w:Setter Property="Visibility" Value="Collapsed"/>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </Border.Theme>
              </Border>
              <ItemsControl Focusable="False" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding MusicBrowserMenuItems}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl.Theme>
                  <ControlTheme TargetType="ItemsControl" BasedOn="{StaticResource {x:Type ItemsControl}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
                    <Setter Property="Grid.ColumnSpan" Value="1"/>
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsMusicSourceBrowser}" Value="True">
                        <w:Setter Property="Grid.ColumnSpan" Value="2"/>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </ItemsControl.Theme>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Button Height="47" Focusable="False" IsEnabled="{Binding IsEnabled}" Command="{Binding DataContext.SelectMusicBrowserMenuItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource MusicBrowserMenuButtonStyle}">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="52"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="36"/>
                        </Grid.ColumnDefinitions>
                        <Image Width="32" Height="32" Stretch="Uniform" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="HighQuality" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <TextBlock FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Text="{Binding Icon}" FontSize="25" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" HorizontalAlignment="Center" VerticalAlignment="Center" w:Wpf.Visibility="{Binding HasIconPath, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="25" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,-1,0,0"/>
                        <TextBlock Grid.Column="2" Text="›" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="24" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                          <TextBlock.Theme>
                            <ControlTheme TargetType="TextBlock">
                              <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                              <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding DataContext.ShowMusicBrowserMenuArrows, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                  <w:Setter Property="Visibility" Value="Visible"/>
                                </w:DataTrigger><w:DataTrigger Binding="{Binding IsSelected}" Value="False">
                                  <w:Setter Property="Visibility" Value="Collapsed"/>
                                </w:DataTrigger></w:TriggerCollection></Template></Setter>
                            </ControlTheme>
                          </TextBlock.Theme>
                        </TextBlock>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Grid Grid.Column="1" w:Wpf.Visibility="{Binding IsMusicSourceBrowser, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                <TextBlock Text="{Binding MusicBrowserDetailTitle}" Foreground="#E8FFFFFF" FontSize="31" FontWeight="Light" Margin="30,26,24,0" TextTrimming="CharacterEllipsis" w:Wpf.Visibility="{Binding HasMusicBrowserResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Image Width="156" Height="112" Stretch="Uniform" Source="{Binding MusicBrowserDetailIconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=192}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,104,0,0" RenderOptions.BitmapInterpolationMode="HighQuality" w:Wpf.Visibility="{Binding HasMusicBrowserResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding MusicBrowserDetailDescription}" Foreground="#D8FFFFFF" FontSize="22" TextWrapping="Wrap" Margin="30,238,42,0" w:Wpf.Visibility="{Binding HasMusicBrowserResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <Button Width="300" Height="72" Background="#01000000" BorderThickness="0" Cursor="Hand" Focusable="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,332,0,0" Command="{Binding OpenMusicFolderCommand}" ZIndex="5" x:Name="__WpfEvt3" w:Wpf.Visibility="{Binding IsMusicFolderLinkVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border Background="{TemplateBinding Background}">
                        <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                      </Border>
                    </ControlTemplate>
                  </Button.Template>
                  <StackPanel>
                    <TextBlock Text="{Binding MusicBrowserSourceFolderTitle}" Foreground="#D8FFFFFF" FontSize="22" FontWeight="Light" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding MusicBrowserSourceFolderPath}" Foreground="#C8FFFFFF" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                  </StackPanel>
                </Button>
                <ScrollViewer Name="MusicBrowserResultsScrollViewer" Focusable="False" KeyboardNavigation.TabNavigation="None" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Margin="18,24,18,58" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding HasMusicBrowserResults, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <ItemsControl Focusable="False" KeyboardNavigation.TabNavigation="None" ItemsSource="{Binding MusicBrowserResultItems}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Height="48" Focusable="False" Command="{Binding DataContext.OpenMusicBrowserResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource MusicTrackButtonStyle}">
                          <Grid>
                            <Grid.Theme>
                              <ControlTheme TargetType="Grid">
                                <Setter Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <w:Setter Property="Background" Value="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
                              </ControlTheme>
                            </Grid.Theme>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="92"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="16,0,8,0" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" Foreground="#FFFFFFFF" FontSize="20" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding Subtitle}" Foreground="#CCFFFFFF" FontSize="12" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="›" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="21" Foreground="#DDFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding MusicBrowserResultCountText}" Foreground="#D8FFFFFF" FontSize="15" VerticalAlignment="Bottom" Margin="30,0,0,24"/>
              </Grid>
            </Grid>
            <Grid w:Wpf.Visibility="{Binding IsMusicNowPlayingVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="440"/>
              </Grid.ColumnDefinitions>
              <Border Background="#EEF0F2F1"/>
              <Border Grid.Column="1" Background="#D9AEB4B7"/>
              <StackPanel Name="MusicPlayerLeftPane" Margin="26,18,26,0" RenderTransformOrigin="0%,0%">
              <StackPanel.RenderTransform>
                <TranslateTransform X="0"/>
              </StackPanel.RenderTransform>
              <StackPanel Orientation="Horizontal">
                <Button Width="58" Height="38" Content="{Binding MusicPlayPauseText}" Command="{Binding PlayPauseMusicCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                <Button Width="58" Height="38" Content="Prev" Margin="5,0,0,0" Command="{Binding PreviousMusicCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                <Button Width="58" Height="38" Content="Stop" Margin="5,0,0,0" Command="{Binding StopMusicCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                <Button Width="58" Height="38" Content="Next" Margin="5,0,0,0" Command="{Binding NextMusicCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                <Button Width="82" Height="38" Margin="5,0,0,0" Content="{Binding ShuffleText}" Command="{Binding ToggleShuffleMusicCommand}" Tag="{Binding IsShuffleEnabled}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
              </StackPanel>
              <TextBlock Text="Edit or Save Playlist" Foreground="#FF55595C" FontSize="22" Margin="0,20,0,14"/>
              <TextBlock Foreground="#FF55595C" FontSize="21" TextTrimming="CharacterEllipsis" Margin="0,22,0,8" Text="{Binding CurrentMusicTitle}"/>
              <Grid Height="44">
                <Border Height="8" Background="#FFB5BABB" VerticalAlignment="Top" Margin="0,8,0,0"/>
                <ProgressBar Height="8" Minimum="0" Maximum="100" Foreground="#FF6D7173" Background="#00FFFFFF" BorderThickness="0" VerticalAlignment="Top" Margin="0,8,0,0" Value="{Binding MusicProgress}" HorizontalAlignment="Stretch"/>
                <TextBlock Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{Binding MusicPositionText}"/>
                <TextBlock Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="{Binding MusicDurationText}"/>
              </Grid>
              <Grid Margin="0,24,0,0">
                <Grid.RowDefinitions>
                  <RowDefinition Height="128"/>
                  <RowDefinition Height="8"/>
                  <RowDefinition Height="96"/>
                </Grid.RowDefinitions>
                <Border ClipToBounds="True">
                  <controls:MusicVisualizer IsActive="{Binding IsMusicPlaying}" Volume="{Binding MusicVolume}" Progress="{Binding MusicProgress}" Bass="{Binding VisualizerBass}" Mid="{Binding VisualizerMid}" Treble="{Binding VisualizerTreble}" Loudness="{Binding VisualizerLoudness}" Peak="{Binding VisualizerPeak}"/>
                </Border>
                <Border Grid.Row="2" Background="#FFE2E5E4">
                  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                      <TextBlock Foreground="#FF7D8385" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding MusicVolumeText, StringFormat=Volume {0}}"/>
                      <Button Width="68" Height="28" Content="Vol -" Command="{Binding VolumeDownCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                      <Button Width="68" Height="28" Content="Vol +" Margin="8,0,0,0" Command="{Binding VolumeUpCommand}" Theme="{StaticResource MusicPlayerButtonStyle}"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </Grid>
            </StackPanel>
            <Grid Name="MusicPlayerTrackPane" Column="1" Margin="0,12,0,0" RenderTransformOrigin="0%,0%">
              <Grid.RenderTransform>
                <TranslateTransform X="0"/>
              </Grid.RenderTransform>
              <ScrollViewer Name="MusicPlayerTracksScrollViewer" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <ItemsControl ItemsSource="{Binding MusicTracks}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Height="48" Focusable="False" Command="{Binding DataContext.PlaySelectedMusicCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource MusicTrackButtonStyle}">
                        <Grid>
                          <Grid.Theme>
                            <ControlTheme TargetType="Grid">
                              <Setter Property="Background" Value="#21FFFFFF"/>
                              <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <w:Setter Property="Background" Value="#A8FFFFFF"/>
                                </w:DataTrigger></w:TriggerCollection></Template></Setter>
                            </ControlTheme>
                          </Grid.Theme>
                          <TextBlock Foreground="#FF5F6669" FontSize="21" Margin="30,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                          <TextBlock Text="playing" Foreground="{Binding DataContext.BladesOverlayAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                            <TextBlock.Theme>
                              <ControlTheme TargetType="TextBlock">
                                <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsPlaying}">
                                    <w:Setter Property="Visibility" Value="Visible"/>
                                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
                              </ControlTheme>
                            </TextBlock.Theme>
                          </TextBlock>
                        </Grid>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Foreground="#FF5F6669" FontSize="15" VerticalAlignment="Bottom" Margin="30,0,0,24" Text="{Binding MusicTrackCountText}"/>
            </Grid>
            </Grid>
          </Grid>
          <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsMusicVisualizerFullscreen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <controls:MusicVisualizer IsActive="{Binding IsMusicPlaying}" Volume="{Binding MusicVolume}" Progress="{Binding MusicProgress}" Bass="{Binding VisualizerBass}" Mid="{Binding VisualizerMid}" Treble="{Binding VisualizerTreble}" Loudness="{Binding VisualizerLoudness}" Peak="{Binding VisualizerPeak}"/>
          </Grid>
          <StackPanel Name="MusicPlayerFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="145,0,0,58" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform X="0"/>
            </StackPanel.RenderTransform>
            <StackPanel.Theme>
              <ControlTheme TargetType="StackPanel">
                <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsMusicVisualizerFullscreen}">
                    <w:Setter Property="Visibility" Value="Collapsed"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </StackPanel.Theme>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#E6FFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back   " Foreground="#E6FFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
            <Grid Background="#00FFFFFF" Cursor="Hand" Margin="0" PointerReleased="MusicFullscreenHint_OnMouseLeftButtonUp">
              <Grid.Theme>
                <ControlTheme TargetType="Grid">
                  <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                  <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsMusicNowPlayingVisible}">
                      <w:Setter Property="Visibility" Value="Visible"/>
                    </w:DataTrigger></w:TriggerCollection></Template></Setter>
                </ControlTheme>
              </Grid.Theme>
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="18" Height="18" CornerRadius="9" Background="#FF2574AA">
                  <TextBlock Text="X" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text=" Fullscreen Visualizer" Foreground="#E6FFFFFF" FontSize="16"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
        <Grid Name="ProfileEditorOverlay" w:Wpf.Visibility="{Binding IsProfileEditorOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#E9000000" Offset="0"/>
              <GradientStop Color="#D20B0E0F" Offset="1"/>
            </LinearGradientBrush>
          </Grid.Background>
          <TextBlock Name="ProfileHeaderTitle" Text="Profile" Foreground="#FFFFFFFF" FontSize="22" FontWeight="SemiBold" Margin="236,62,0,0" RenderTransformOrigin="0%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform/>
            </TextBlock.RenderTransform>
          </TextBlock>
          <Button Name="ProfileTopGamerPictureButton" Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,42,0,0" Command="{Binding ChooseProfilePictureCommand}" Focusable="False" Theme="{StaticResource X360TileButtonStyle}" ToolTip.Tip="Change gamer picture" RenderTransformOrigin="0%,0%">
            <Button.RenderTransform>
              <TranslateTransform/>
            </Button.RenderTransform>
            <Image Stretch="UniformToFill" Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
          </Button>
          <TextBlock Name="ProfileClockChrome" Foreground="#E8FFFFFF" FontSize="22" HorizontalAlignment="Right" Margin="0,62,236,0" VerticalAlignment="Top" Text="{Binding ProfileClockText}" RenderTransformOrigin="0%,0%">
            <TextBlock.RenderTransform>
              <TranslateTransform/>
            </TextBlock.RenderTransform>
          </TextBlock>
          <Grid Name="ProfilePanelFrame" Width="880" Height="526" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24,0,0" RenderTransformOrigin="0%,0%">
            <Grid.RenderTransform>
              <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="440"/>
              <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>
            <Border Background="#EEF4F6F5" BorderBrush="#D8FFFFFF" BorderThickness="1,1,0,1"/>
            <Border Grid.Column="1" Background="#D0646C70" BorderBrush="#A8AEB3B5" BorderThickness="0,1,1,1"/>
            <StackPanel>
              <Button Name="ProfileMenuViewGamesButton" Content="View Games" Background="#F9FFFFFF" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Name="ProfileMenuEditButton" Content="{Binding ProfileEditMenuText}" Tag="ProfileMenuOption" Command="{Binding ToggleProfileEditCommand}" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Content="View Rep" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Content="Game Defaults" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Content="Sign-in Preferences" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Content="Account Security" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
              <Button Content="Manage Exercise Info" Tag="ProfileMenuOption" Theme="{StaticResource ProfileMenuButtonStyle}"/>
            </StackPanel>
            <Grid Grid.Column="1">
              <Border Height="128" VerticalAlignment="Top" Background="#FFF8F8F8" Margin="14,14,14,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="38"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Background="#FFFF7A00">
                    <Grid>
                      <TextBlock Foreground="#FFFFFFFF" FontSize="24" Margin="16,0,0,0" VerticalAlignment="Center" Text="{Binding Profile.Gamertag}" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                      <TextBox Name="ProfileEditableGamertagBox" Height="30" Margin="12,4,12,4" Padding="6,0" FontSize="22" VerticalContentAlignment="Center" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" Text="{Binding EditableProfileGamertag, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid>
                  </Border>
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="92"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Width="74" Height="74" Margin="14,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ChooseProfilePictureCommand}" Focusable="False" Theme="{StaticResource X360TileButtonStyle}" ToolTip.Tip="Change gamer picture">
                      <Image Stretch="UniformToFill" Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                    </Button>
                    <Grid Grid.Column="1" Margin="16,6,18,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="28"/>
                      </Grid.RowDefinitions>
                      <TextBlock Text="Rep" Foreground="#FF252A2E" FontSize="20"/>
                      <TextBlock Grid.Column="1" Text="★★★★★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FF8A8F93" FontSize="22" HorizontalAlignment="Right"/>
                      <TextBlock Grid.Row="1" Text="Gamerscore" Foreground="#FF252A2E" FontSize="20"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" Foreground="#FF252A2E" FontSize="20" HorizontalAlignment="Right" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <Run Text="{Binding Profile.Gamerscore, Mode=OneWay}"/><Run Text=" G"/>
                      </TextBlock>
                      <TextBox Grid.Row="1" Grid.Column="1" Width="116" Height="28" Padding="5,0" FontSize="18" HorizontalAlignment="Right" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" Text="{Binding EditableProfileGamerscore, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                      <TextBlock Grid.Row="2" Text="Zone" Foreground="#FF252A2E" FontSize="20"/>
                      <TextBlock Grid.Row="2" Grid.Column="1" Text="Recreation" Foreground="#FF252A2E" FontSize="20" HorizontalAlignment="Right"/>
                    </Grid>
                  </Grid>
                </Grid>
              </Border>
              <StackPanel Margin="42,164,36,0">
                <TextBlock Foreground="#F0FFFFFF" FontSize="23" Margin="0,0,0,24" Text="{Binding Profile.Motto}" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBox Name="ProfileEditableMottoBox" Height="36" FontSize="22" Margin="0,0,0,17" Padding="8,1" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" Text="{Binding EditableProfileMotto, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Foreground="#F0FFFFFF" FontSize="23" Margin="0,0,0,2" Text="{Binding Profile.Name}" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBox Name="ProfileEditableUsernameBox" Height="36" FontSize="22" Margin="0,0,0,2" Padding="8,1" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" Text="{Binding EditableProfileName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Foreground="#F0FFFFFF" FontSize="23" Margin="0,0,0,26" Text="{Binding Profile.Location}" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBox Name="ProfileEditableLocationBox" Height="36" FontSize="22" Margin="0,0,0,17" Padding="8,1" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" Text="{Binding EditableProfileLocation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Foreground="#F0FFFFFF" FontSize="23" TextWrapping="Wrap" Text="{Binding Profile.Description}" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                <TextBox Name="ProfileEditableDescriptionBox" Height="82" FontSize="22" Padding="8,3" Background="#FFF8F8F8" Foreground="#FF111111" BorderBrush="#FFC9CED0" BorderThickness="2" TextWrapping="Wrap" AcceptsReturn="True" Text="{Binding EditableProfileDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Tag="ProfileEditField" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ScrollViewer.VerticalScrollBarVisibility="Disabled" w:Wpf.Visibility="{Binding IsProfileMenuEditing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
              </StackPanel>
            </Grid>
          </Grid>
          <StackPanel Name="ProfileFooterChrome" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="138,0,0,38" RenderTransformOrigin="0%,0%">
            <StackPanel.RenderTransform>
              <TranslateTransform/>
            </StackPanel.RenderTransform>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#FFFFFFFF" FontSize="15"/>
            <Border Width="18" Height="18" CornerRadius="9" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back" Foreground="#FFFFFFFF" FontSize="15" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
          </StackPanel>
        </Grid>
        <Grid Name="FakeLoadingOverlay" Opacity="0" IsHitTestVisible="True" w:Wpf.Visibility="Collapsed">
          <Grid.Background>
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
              <GradientStop Color="#FF384141" Offset="0"/>
              <GradientStop Color="#FF65706E" Offset="0.44"/>
              <GradientStop Color="#FF9A9F9C" Offset="1"/>
            </LinearGradientBrush>
          </Grid.Background>
          <Rectangle Opacity="0.32">
            <Rectangle.Fill>
              <RadialGradientBrush Center="50%,34%" RadiusX="72%" RadiusY="72%">
                <GradientStop Color="#88FFFFFF" Offset="0"/>
                <GradientStop Color="#28FFFFFF" Offset="0.5"/>
                <GradientStop Color="#00000000" Offset="1"/>
              </RadialGradientBrush>
            </Rectangle.Fill>
          </Rectangle>
          <Grid IsHitTestVisible="False">
            <Grid.Theme><ControlTheme TargetType="Grid"><Setter Property="w:Wpf.Visibility" Value="Collapsed"/><Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades"><w:Setter Property="Visibility" Value="Visible"/></w:DataTrigger></w:TriggerCollection></Template></Setter></ControlTheme></Grid.Theme>
            <controls:BladeAmbientTexture Tint="#FF328DCA"/>
            <Grid x:Name="BladesLoadingChrome">
            <Border Height="88" VerticalAlignment="Top" Background="#30435467" BorderBrush="#50718891" BorderThickness="0,0,0,1">
              <TextBlock x:Name="BladesLoadingTitle" Foreground="#FFE5EAEA" FontFamily="Convection, avares://DashX360/Fonts#Selawik" FontSize="27" Margin="166,0,0,12" VerticalAlignment="Bottom">
                <TextBlock.Theme><ControlTheme TargetType="TextBlock"><Setter Property="Text" Value="{Binding ActiveBladesTitle}"/><Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsLauncherSettingsOpen}" Value="True"><w:Setter Property="Text" Value="Console"/></w:DataTrigger><w:DataTrigger Binding="{Binding IsMyGamesOpen}" Value="True"><w:Setter Property="Text" Value="Game Library"/></w:DataTrigger><w:DataTrigger Binding="{Binding IsMusicPlayerOpen}" Value="True"><w:Setter Property="Text" Value="{Binding MusicPlayerHeaderText}"/></w:DataTrigger></w:TriggerCollection></Template></Setter></ControlTheme></TextBlock.Theme>
              </TextBlock>
            </Border>
            <Border Height="120" VerticalAlignment="Bottom" Background="#234E6379" BorderBrush="#805D8596" BorderThickness="0,1,0,0"/>
            <StackPanel HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,166,48" IsHitTestVisible="False">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Back" FontSize="24" Foreground="#FFE7EBE9" Margin="0,0,4,0"/><controls:BladePadGlyph Letter="B" Width="25" Height="25"/></StackPanel>
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><TextBlock Text="Select" FontSize="24" Foreground="#FFE7EBE9" Margin="0,0,4,0"/><controls:BladePadGlyph Letter="A" Width="25" Height="25"/></StackPanel>
            </StackPanel>
          </Grid>
          </Grid>
          <Grid Name="FakeLoadingIndicator" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,-2" IsHitTestVisible="False">
            <Canvas Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center">
              <Canvas.Theme><ControlTheme TargetType="Canvas"><Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades"><w:Setter Property="Visibility" Value="Collapsed"/></w:DataTrigger></w:TriggerCollection></Template></Setter></ControlTheme></Canvas.Theme>
              <Path Name="FakeLoadingRing" Stroke="#F4FFFFFF" StrokeThickness="3.7" Data="M48,23 A25,25 0 1 1 31,66" StrokeLineCap="Round" RenderTransformOrigin="0%,0%">
                <Path.RenderTransform>
                  <RotateTransform Angle="0" CenterX="48" CenterY="48"/>
                </Path.RenderTransform>
              </Path>
            </Canvas>
            <controls:BladesLoadingIndicator Width="76" Height="76">
              <controls:BladesLoadingIndicator.Theme><ControlTheme TargetType="controls:BladesLoadingIndicator"><Setter Property="w:Wpf.Visibility" Value="Collapsed"/><Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades"><w:Setter Property="Visibility" Value="Visible"/></w:DataTrigger></w:TriggerCollection></Template></Setter></ControlTheme></controls:BladesLoadingIndicator.Theme>
            </controls:BladesLoadingIndicator>
          </Grid>
        </Grid>
        <Canvas Name="SignInToastOverlay" Width="1280" Height="720" ClipToBounds="False" IsHitTestVisible="False" ZIndex="1000">
          <Canvas Name="SignInToast" Width="319.3333" Height="78.6667" ClipToBounds="False" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="50%,50%" Canvas.Left="479.3333" Canvas.Top="581.3333">
            <Canvas.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform Y="0"/>
              </TransformGroup>
            </Canvas.RenderTransform>
            <Canvas.Effect>
              <DropShadowEffect BlurRadius="15" Color="#AA000000" Opacity="0.72" OffsetX="0" OffsetY="2"/>
            </Canvas.Effect>
            <Border Name="SignInToastGlow" Canvas.Left="8.6667" Canvas.Top="7.3333" Width="302" Height="64" CornerRadius="32" Opacity="0" RenderTransformOrigin="0%,50%" BorderThickness="1" ZIndex="0">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="1"/>
              </Border.RenderTransform>
              <Border.BorderBrush>
                <SolidColorBrush Color="#72FFFFFF"/>
              </Border.BorderBrush>
              <Border.Effect>
                <DropShadowEffect BlurRadius="12" Color="#D6FFFFFF" Opacity="0.36" OffsetX="0" OffsetY="0"/>
              </Border.Effect>
            </Border>
            <Border Name="SignInToastPill" Canvas.Left="8.6667" Canvas.Top="7.3333" Width="302" Height="64" CornerRadius="32" Opacity="0" RenderTransformOrigin="0%,50%" ZIndex="1">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="1"/>
              </Border.RenderTransform>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#EA5A5D5D" Offset="0"/>
                  <GradientStop Color="#F0444646" Offset="0.42"/>
                  <GradientStop Color="#F02C2E2E" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
              <Border.BorderBrush>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#9EFFFFFF" Offset="0"/>
                  <GradientStop Color="#38FFFFFF" Offset="0.48"/>
                  <GradientStop Color="#66000000" Offset="1"/>
                </LinearGradientBrush>
              </Border.BorderBrush>
            </Border>
            <Border Name="SignInToastPillHighlight" Canvas.Left="67.3334" Canvas.Top="18" Width="188" Height="8" CornerRadius="8" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0%,50%" ZIndex="2">
              <Border.RenderTransform>
                <ScaleTransform ScaleX="0" ScaleY="1"/>
              </Border.RenderTransform>
              <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                  <GradientStop Color="#00FFFFFF" Offset="0"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </LinearGradientBrush>
              </Border.Background>
            </Border>
            <Grid Name="SignInToastIcon" Width="64" Height="64" Canvas.Left="8.6667" Canvas.Top="7.3333" Margin="0" ClipToBounds="False" Opacity="0" ZIndex="3" RenderTransformOrigin="50%,50%">
              <Grid.RenderTransform>
                <ScaleTransform ScaleX="0.5" ScaleY="0.5"/>
              </Grid.RenderTransform>
              <Grid Name="SignInToastIconSphere" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
                <Image Source="{Binding Source=Assets/Misc/SignIn/xbox-orb.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" Width="64" Height="64" Margin="0" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              </Grid>
              <Grid Name="SignInToastIconAlert" Width="64" Height="64" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="1">
                <Image Source="{Binding Source=Assets/Misc/SignIn/live-alert.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" Width="64" Height="64" Margin="0" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              </Grid>
            </Grid>
            <Canvas Name="SignInToastText" Width="226.6667" Height="60" Opacity="0" ZIndex="4" ClipToBounds="False" UseLayoutRounding="True" Canvas.Left="78.6667" Canvas.Top="12.6667">
              <Canvas Opacity="0.16" ClipToBounds="False" IsHitTestVisible="False" UseLayoutRounding="True">
                <Canvas.Effect>
                  <DropShadowEffect BlurRadius="6" Color="#FFFFFFFF" Opacity="1" OffsetX="0" OffsetY="0"/>
                </Canvas.Effect>
                <TextBlock Canvas.Left="0" Canvas.Top="0" Width="226.6667" ClipToBounds="False" Foreground="#FFFFFFFF" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="Normal" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding NotificationToastLine1}"/>
                <TextBlock Canvas.Left="0" Canvas.Top="23.3333" Width="226.6667" ClipToBounds="False" Foreground="#FFFFFFFF" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="Normal" TextWrapping="NoWrap" Text="{Binding NotificationToastLine2}"/>
              </Canvas>
              <TextBlock Canvas.Left="0" Canvas.Top="0" Width="226.6667" ClipToBounds="False" Foreground="#F8FFFFFF" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="Normal" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Text="{Binding NotificationToastLine1}"/>
              <TextBlock Canvas.Left="0" Canvas.Top="23.3333" Width="226.6667" ClipToBounds="False" Foreground="#F8FFFFFF" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="Normal" TextWrapping="NoWrap" Text="{Binding NotificationToastLine2}"/>
            </Canvas>
          </Canvas>
        </Canvas>
      </Grid>
      </Grid>
    </Viewbox>
    <Grid Name="YouTubeTvOverlay" Background="#FF050505" w:Wpf.Visibility="{Binding IsYouTubeTvOpen, Converter={StaticResource BooleanToVisibilityConverter}}" ZIndex="80">
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="48"/>
      </Grid.RowDefinitions>
      <ContentControl Name="YouTubeTvHost" Grid.Row="0" Focusable="False"/>
      <Border Grid.Row="1" Background="#FF050505">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="64,0,0,0">
          <Grid Width="20" Height="20" Margin="0,0,8,0">
            <Ellipse Fill="#FF69C242"/>
            <TextBlock Text="A" Foreground="White" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Select" Foreground="White" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="18" Margin="0,0,24,0"/>
          <Grid Width="20" Height="20" Margin="0,0,8,0">
            <Ellipse Fill="#FFE85050"/>
            <TextBlock Text="B" Foreground="White" FontFamily="avares://DashX360/Fonts#Selawik" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <TextBlock Text="Back" Foreground="White" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="18"/>
        </StackPanel>
      </Border>
    </Grid>
    <Grid Name="BootOverlay" Background="#FFFFFFFF" w:Wpf.Visibility="{Binding IsBooting, Converter={StaticResource BooleanToVisibilityConverter}}">
      <w:VideoView Name="BootVideoHost"/>
      <Viewbox Stretch="Uniform" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
        <Canvas Width="1280" Height="720">
        <TextBlock Canvas.Left="902" Canvas.Top="430" Text="®" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="18" Foreground="#FF9C9C9C" Opacity="0.85"/>
        </Canvas>
      </Viewbox>
    </Grid>
  </Grid>
</Window>
