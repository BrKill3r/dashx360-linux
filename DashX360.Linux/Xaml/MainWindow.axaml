<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:XboxMetroLauncher.Controls" xmlns:xboxmetrolauncher="using:XboxMetroLauncher" x:Class="XboxMetroLauncher.MainWindow" Title="DashX360" Width="1280" Height="720" MinWidth="1024" MinHeight="576" Background="{StaticResource DashboardBackgroundBrush}" WindowStartupLocation="CenterScreen" Loaded="Window_OnLoaded" Closing="Window_OnClosing" xmlns:w="using:XboxMetroLauncher.Compat">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://DashX360/Xaml/bladethemes/DashX360_CenterBladeBodies.axaml"/>
      </ResourceDictionary.MergedDictionaries>
      <DropShadowEffect x:Key="BladeTitleShadowEffect" BlurRadius="3" Opacity="0.45" Color="#FF242424" OffsetX="0.707" OffsetY="0.707"/>
      <DropShadowEffect x:Key="BladeFooterShadowEffect" BlurRadius="3" Opacity="0.42" Color="#FF242424" OffsetX="0.707" OffsetY="0.707"/>
      <LinearGradientBrush x:Key="BladeSelectedRowBrush" StartPoint="0%,50%" EndPoint="100%,50%">
        <GradientStop Color="#FAFFFFFF" Offset="0"/>
        <GradientStop Color="#EEF5F0EA" Offset="0.44"/>
        <GradientStop Color="#DDE7E4DB" Offset="1"/>
      </LinearGradientBrush>
      <ControlTheme x:Key="BladeTextBaseStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="FontStretch" Value="Normal"/>
        
        <Setter Property="UseLayoutRounding" Value="True"/>
        
        
      </ControlTheme>
      <ControlTheme x:Key="BladeSectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="30"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStretch" Value="Normal"/>
        <Setter Property="Foreground" Value="#F4FFFFFF"/>
        <Setter Property="Effect" Value="{StaticResource BladeTitleShadowEffect}"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeMenuTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="21"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FF171717"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeSelectedMenuTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeMenuTextStyle}">
        <Setter Property="FontWeight" Value="SemiBold"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeDetailTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="25"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#FF171717"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeBodyTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="19"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FF171717"/>
            <Setter Property="LineHeight" Value="27"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeProfileGamertagStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
        <Setter Property="FontSize" Value="27"/>
        <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik, Xbox 360, Convection"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#FF111111"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeProfileTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
        <Setter Property="FontSize" Value="24"/>
        <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik, Xbox 360, Convection"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Foreground" Value="#FF101010"/>
        <Setter Property="LineHeight" Value="28"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeOpenTrayTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="Foreground" Value="#FF111111"/>
      </ControlTheme>
      <ControlTheme x:Key="BladeFooterTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BladeTextBaseStyle}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontFamily" Value="Convection, Xbox 360, avares://DashX360/Fonts#Selawik"/>
            <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStretch" Value="Normal"/>
        <Setter Property="Foreground" Value="#FFFFFFFF"/>
        <Setter Property="Effect" Value="{StaticResource BladeFooterShadowEffect}"/>
      </ControlTheme>
      
      <ControlTheme x:Key="SettingsActionButtonStyle" TargetType="Button" BasedOn="{StaticResource MetroActionButtonStyle}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Background" Value="{DynamicResource MetroGreenBrush}"/>
        
        <Setter Property="BorderBrush" Value="#88FFFFFF"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
            <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
            <w:Setter Property="BorderBrush" Value="#FFFFFFFF"/>
            <w:Setter Property="BorderThickness" Value="2"/>
          </w:Trigger></w:TriggerCollection></Template></Setter>
      </ControlTheme>
      <ControlTheme x:Key="ProfileMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Background" Value="#F1F6F7F6"/>
        <Setter Property="Foreground" Value="#FF252A2E"/>
        <Setter Property="BorderBrush" Value="#77C1C8CB"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
        <Setter Property="FontSize" Value="23"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Padding" Value="28,0,0,1"/>
        
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="IsKeyboardFocused" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{w:DynRes MetroGreenBrush}"/>
                  <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  <w:Setter Property="BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                </w:Trigger><w:Trigger Property="IsMouseOver" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{w:DynRes MetroGreenBrush}"/>
                  <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  <w:Setter Property="BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{w:DynRes MetroGreenBrush}"/>
                  <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
              </Border>
              
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="BladesMenuButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="42"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="Background" Value="#00FFFFFF"/>
        <Setter Property="BorderBrush" Value="#6A315C2E"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Foreground" Value="#FF1B1B1B"/>
        <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
        <Setter Property="FontSize" Value="21"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontStretch" Value="Condensed"/>
        
        <Setter Property="UseLayoutRounding" Value="True"/>
        
        
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" ClipToBounds="True"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{StaticResource BladeSelectedRowBrush}"/>
                  <w:Setter TargetName="Root" Property="BorderBrush" Value="#6E7D857B"/>
                  <w:Setter TargetName="SelectedSheen" Property="Opacity" Value="1"/>
                  <w:Setter TargetName="SelectedTopLine" Property="Opacity" Value="1"/>
                  <w:Setter TargetName="SelectedBottomShadow" Property="Opacity" Value="1"/>
                  <w:Setter Property="Foreground" Value="#FF111111"/>
                  <w:Setter Property="FontWeight" Value="SemiBold"/>
                </w:DataTrigger><w:Trigger Property="IsMouseOver" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="#DDF4FAF1"/>
                  <w:Setter TargetName="Root" Property="BorderBrush" Value="#8A2F682D"/>
                  <w:Setter Property="Foreground" Value="#FF111111"/>
                </w:Trigger><w:Trigger Property="IsKeyboardFocused" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="#DDF4FAF1"/>
                  <w:Setter TargetName="Root" Property="BorderBrush" Value="#8A2F682D"/>
                  <w:Setter Property="Foreground" Value="#FF111111"/>
                </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{Binding DataContext.ActiveBladesAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                  <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                </w:Trigger><w:Trigger Property="IsEnabled" Value="False">
                  <w:Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                <Grid>
                  <Rectangle x:Name="SelectedSheen" Opacity="0">
                    <Rectangle.Fill>
                      <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#ECFFFFFF" Offset="0"/>
                        <GradientStop Color="#BFEAF4E2" Offset="0.42"/>
                        <GradientStop Color="#62C8D7C0" Offset="1"/>
                      </LinearGradientBrush>
                    </Rectangle.Fill>
                  </Rectangle>
                  <Rectangle x:Name="SelectedTopLine" Height="1" Fill="#DFFFFFFF" VerticalAlignment="Top" Opacity="0"/>
                  <Rectangle x:Name="SelectedBottomShadow" Height="2" Fill="#44262F24" VerticalAlignment="Bottom" Opacity="0"/>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Grid>
              </Border>
              
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>
      <ControlTheme x:Key="BladesShelfButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="Height" Value="72"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="Background" Value="#72D7F0C7"/>
        <Setter Property="BorderBrush" Value="#77315C2E"/>
        <Setter Property="BorderThickness" Value="2"/>
        <Setter Property="Foreground" Value="#FF111111"/>
        <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Padding" Value="0"/>
        
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Binding="{Binding IsSelected}" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="#EAF4F7F0"/>
                  <w:Setter TargetName="Root" Property="BorderBrush" Value="#88315C2E"/>
                </w:DataTrigger><w:Trigger Property="IsMouseOver" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="#EAF4F7F0"/>
                </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                  <w:Setter TargetName="Root" Property="Background" Value="{Binding DataContext.ActiveBladesAccentBrush, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </w:Trigger><w:Trigger Property="IsEnabled" Value="False">
                  <w:Setter TargetName="Root" Property="Opacity" Value="0.45"/>
                </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                <Border.Effect>
                  <DropShadowEffect BlurRadius="5" Opacity="0.3" Color="#FF1E3B1D" OffsetX="0" OffsetY="2"/>
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
              </Border>
              
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </ControlTheme>
    </ResourceDictionary>
  </Window.Resources>
  <Grid Background="{StaticResource DashboardBackgroundBrush}">
    <Grid Name="UltraWideThemeBackgroundLayer" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
      <Image Name="UltraWideThemeBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapInterpolationMode="HighQuality"/>
      <Rectangle Fill="#33000000"/>
    </Grid>
    <Grid Name="UltraWideBingBackgroundLayer" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
      <Image Name="UltraWideBingBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapInterpolationMode="HighQuality"/>
      <Rectangle Fill="#18000000"/>
    </Grid>
    <Grid Name="AudioHost" Width="1" Height="1" Opacity="0" IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top"/>
    <Viewbox Stretch="Uniform">
      <Grid Name="DashboardAspectFrame" Width="{Binding DashboardAspectFrameWidth}" Height="{Binding DashboardAspectFrameHeight}" ClipToBounds="True" Background="{StaticResource DashboardBackgroundBrush}">
      <Grid Name="RootGrid" Width="1280" Height="720" HorizontalAlignment="Center" VerticalAlignment="Center" ClipToBounds="True" Background="{StaticResource DashboardBackgroundBrush}">
        <Grid Name="ThemeBackgroundLayer" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
          <Image Name="ThemeBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Rectangle Fill="#33000000"/>
        </Grid>
        <Grid Name="BingBackgroundLayer" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed">
          <Image Name="BingBackgroundImage" Stretch="UniformToFill" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Rectangle Fill="#18000000"/>
        </Grid>
        <Rectangle Opacity="0.08">
          <Rectangle.Fill>
            <RadialGradientBrush Center="28%,22%" RadiusX="85%" RadiusY="70%">
              <GradientStop Color="#CCFFFFFF" Offset="0"/>
              <GradientStop Color="#66FFFFFF" Offset="0.45"/>
              <GradientStop Color="#00FFFFFF" Offset="1"/>
            </RadialGradientBrush>
          </Rectangle.Fill>
        </Rectangle>
        <Grid Name="DashboardContentHost" Opacity="1" RenderTransformOrigin="50%,50%">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
              <TranslateTransform Y="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Grid.Theme>
            <ControlTheme TargetType="Grid">
              <Setter Property="w:Wpf.Visibility" Value="Visible"/>
              <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsBooting}">
                  <w:Setter Property="Visibility" Value="Collapsed"/>
                </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding IsDashboardContentHidden}">
                  <w:Setter Property="Visibility" Value="Collapsed"/>
                </w:DataTrigger></w:TriggerCollection></Template></Setter>
            </ControlTheme>
          </Grid.Theme>
          <Grid.RowDefinitions>
            <RowDefinition Height="146"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="72"/>
          </Grid.RowDefinitions>
          <Grid Grid.RowSpan="3" IsHitTestVisible="False">
            <Grid.Theme>
              <ControlTheme TargetType="Grid">
                <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                    <w:Setter Property="Visibility" Value="Visible"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </Grid.Theme>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                  <GradientStop Color="#FF1D596B" Offset="0"/>
                  <GradientStop Color="#FF0F79AE" Offset="0.34"/>
                  <GradientStop Color="#FF153850" Offset="0.62"/>
                  <GradientStop Color="#FF101820" Offset="1"/>
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Rectangle Opacity="0.46">
              <Rectangle.Fill>
                <RadialGradientBrush Center="46%,18%" RadiusX="70%" RadiusY="52%">
                  <GradientStop Color="#AAFFFFFF" Offset="0"/>
                  <GradientStop Color="#3CFFFFFF" Offset="0.38"/>
                  <GradientStop Color="#00FFFFFF" Offset="1"/>
                </RadialGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Canvas>
              <Border Canvas.Left="-56" Canvas.Top="150" Width="154" Height="424" Background="#74EAF2F5" BorderBrush="#99FFFFFF" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="24" Color="#FF000000" Opacity="0.2" OffsetX="3" OffsetY="0"/>
                </Border.Effect>
              </Border>
              <Border Canvas.Left="1182" Canvas.Top="150" Width="154" Height="424" Background="#74EAF2F5" BorderBrush="#99FFFFFF" BorderThickness="1">
                <Border.Effect>
                  <DropShadowEffect BlurRadius="24" Color="#FF000000" Opacity="0.2" OffsetX="-3" OffsetY="0"/>
                </Border.Effect>
              </Border>
              <Rectangle Canvas.Left="100" Canvas.Top="128" Width="1080" Height="470" Fill="#32FFFFFF"/>
              <Rectangle Canvas.Left="100" Canvas.Top="128" Width="1080" Height="470" Stroke="#82FFFFFF" StrokeThickness="1"/>
            </Canvas>
          </Grid>
          <Grid Row="0">
            <Canvas Margin="0,112,0,0" Height="46" HorizontalAlignment="Stretch" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0.12" w:Wpf.Visibility="Collapsed">
              <TextBlock Canvas.Left="180" Width="58" Height="40" Text="bing" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="274" Width="78" Height="40" Text="home" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="388" Width="86" Height="40" Text="social" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="512" Width="82" Height="40" Text="video" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="634" Width="94" Height="40" Text="games" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="776" Width="88" Height="40" Text="music" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="896" Width="68" Height="40" Text="apps" Theme="{StaticResource TabGhostTextStyle}"/>
              <TextBlock Canvas.Left="994" Width="128" Height="40" Text="settings" Theme="{StaticResource TabGhostTextStyle}"/>
            </Canvas>
            <Canvas Margin="0,112,0,0" Height="46" HorizontalAlignment="Stretch" VerticalAlignment="Top" w:Wpf.Visibility="{Binding IsMyGamesOpen, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
              <Canvas.Theme>
                <ControlTheme TargetType="Canvas">
                  <Setter Property="Opacity" Value="1"/>
                  <Setter Property="IsHitTestVisible" Value="True"/>
                  <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                      <w:Setter Property="Opacity" Value="0"/>
                      <w:Setter Property="IsHitTestVisible" Value="False"/>
                    </w:DataTrigger></w:TriggerCollection></Template></Setter>
                </ControlTheme>
              </Canvas.Theme>
              <Button Canvas.Left="180" Canvas.Top="0" Width="58" Height="40" Content="bing" DataContext="{Binding Tabs[0]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="274" Canvas.Top="0" Width="78" Height="40" Content="home" DataContext="{Binding Tabs[1]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="388" Canvas.Top="0" Width="86" Height="40" Content="social" DataContext="{Binding Tabs[2]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="512" Canvas.Top="0" Width="82" Height="40" Content="video" DataContext="{Binding Tabs[3]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="634" Canvas.Top="0" Width="94" Height="40" Content="games" DataContext="{Binding Tabs[4]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="776" Canvas.Top="0" Width="88" Height="40" Content="music" DataContext="{Binding Tabs[5]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="896" Canvas.Top="0" Width="68" Height="40" Content="apps" DataContext="{Binding Tabs[6]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
              <Button Canvas.Left="994" Canvas.Top="0" Width="128" Height="40" Content="settings" DataContext="{Binding Tabs[7]}" Command="{Binding DataContext.SwitchTabCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource TabButtonStyle}"/>
            </Canvas>
            <Grid HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,42,96,0" Width="360" Height="38" Opacity="0.88" IsHitTestVisible="False">
              <Grid.Theme>
                <ControlTheme TargetType="Grid">
                  <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                  <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                      <w:Setter Property="Visibility" Value="Collapsed"/>
                    </w:DataTrigger></w:TriggerCollection></Template></Setter>
                </ControlTheme>
              </Grid.Theme>
              <Grid Name="TopRightPlainState" HorizontalAlignment="Right" Opacity="1">
                <Grid.Theme>
                  <ControlTheme TargetType="Grid">
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding ShowTopRightGamertag}" Value="False">
                        <w:DataTrigger.EnterActions>
                          <w:BeginStoryboard>
                            <w:Storyboard>
                              <w:DoubleAnimation To="0" Duration="0:0:0.28" TargetProperty="Opacity"/>
                            </w:Storyboard>
                          </w:BeginStoryboard>
                        </w:DataTrigger.EnterActions>
                        <w:DataTrigger.ExitActions>
                          <w:BeginStoryboard>
                            <w:Storyboard>
                              <w:DoubleAnimation To="1" Duration="0:0:0.28" TargetProperty="Opacity"/>
                            </w:Storyboard>
                          </w:BeginStoryboard>
                        </w:DataTrigger.ExitActions>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </Grid.Theme>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                  <TextBlock Foreground="#F0FFFFFF" FontSize="19" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,9,0" Text="{Binding Profile.Gamertag}">
                    <TextBlock.Effect>
                      <DropShadowEffect BlurRadius="4" Opacity="0.35" Color="#FF111111" OffsetX="0.707" OffsetY="0.707"/>
                    </TextBlock.Effect>
                  </TextBlock>
                </StackPanel>
              </Grid>
              <Grid Name="TopRightStatsState" HorizontalAlignment="Right" Opacity="0">
                <Grid.Theme>
                  <ControlTheme TargetType="Grid">
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding ShowTopRightStats}" Value="True">
                        <w:DataTrigger.EnterActions>
                          <w:BeginStoryboard>
                            <w:Storyboard>
                              <w:DoubleAnimation To="1" Duration="0:0:0.28" TargetProperty="Opacity"/>
                            </w:Storyboard>
                          </w:BeginStoryboard>
                        </w:DataTrigger.EnterActions>
                        <w:DataTrigger.ExitActions>
                          <w:BeginStoryboard>
                            <w:Storyboard>
                              <w:DoubleAnimation To="0" Duration="0:0:0.28" TargetProperty="Opacity"/>
                            </w:Storyboard>
                          </w:BeginStoryboard>
                        </w:DataTrigger.ExitActions>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </Grid.Theme>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,40,0">
                  <TextBlock Text="🗪" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#E8FFFFFF" FontSize="20" VerticalAlignment="Center" Margin="0,0,5,0"/>
                  <TextBlock Foreground="#F0FFFFFF" FontSize="18" VerticalAlignment="Center" Margin="0,0,18,0" Text="{Binding TopRightFriendCountText}"/>
                  <TextBlock Foreground="#F0FFFFFF" FontSize="18" VerticalAlignment="Center" Margin="0,0,5,0" Text="{Binding TopRightGamerscoreText}"/>
                  <TextBlock Foreground="#F0FFFFFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,0,0" Text="G"/>
                </StackPanel>
              </Grid>
              <Border Width="31" Height="31" HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource MetroGreenBrush}" ClipToBounds="True">
                <Image Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
              </Border>
            </Grid>
          </Grid>
          <Grid Name="BladesDashboardOverlay" Grid.RowSpan="3" Focusable="False" RenderTransformOrigin="50%,50%" ZIndex="40">
            <Grid.RenderTransform>
              <TransformGroup>
                <ScaleTransform ScaleX="1" ScaleY="1"/>
                <TranslateTransform Y="0"/>
              </TransformGroup>
            </Grid.RenderTransform>
            <Grid.Theme>
              <ControlTheme TargetType="Grid">
                <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding Settings.DashboardStyle}" Value="Blades">
                    <w:Setter Property="Visibility" Value="Visible"/>
                  </w:DataTrigger></w:TriggerCollection></Template></Setter>
              </ControlTheme>
            </Grid.Theme>
            <Viewbox Width="1280" Height="720" Stretch="Uniform">
              <Canvas Width="1920" Height="1080" ClipToBounds="False">
                <Canvas.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FFD7DADB" Offset="0"/>
                    <GradientStop Color="#FFF4F4F2" Offset="0.18"/>
                    <GradientStop Color="#FFD6DADB" Offset="1"/>
                  </LinearGradientBrush>
                </Canvas.Background>
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Fill="{Binding ActiveBladesAccentBrush}" ZIndex="0"/>
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0.12" ZIndex="1">
                  <Rectangle.Fill>
                    <RadialGradientBrush Center="46%,18%" RadiusX="84%" RadiusY="70%">
                      <GradientStop Color="#88FFFFFF" Offset="0"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <controls:BladeCenterHost x:Name="BladesCenterHost" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" FocusedBladeKey="{Binding ActiveBladesBlade.Key}" ZIndex="2"/>
                <Rectangle x:Name="BladesStartupGreenReveal" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed" ZIndex="3">
                  <Rectangle.Fill>
                    <RadialGradientBrush Center="50%,48%" RadiusX="62%" RadiusY="78%">
                      <GradientStop Color="#FFBFECC2" Offset="0"/>
                      <GradientStop Color="#FF77CF58" Offset="0.45"/>
                      <GradientStop Color="#FF3AAD2C" Offset="1"/>
                    </RadialGradientBrush>
                  </Rectangle.Fill>
                </Rectangle>
                <controls:BladesArtworkHost x:Name="BladesArtworkHost" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" FocusedBladeKey="{Binding ActiveBladesBlade.Key}" ZIndex="7">
                  <controls:BladesArtworkHost.Theme>
                    <ControlTheme TargetType="controls:BladesArtworkHost">
                      <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesSubmenuOpen}" Value="True">
                          <w:Setter Property="Visibility" Value="Collapsed"/>
                        </w:DataTrigger></w:TriggerCollection></Template></Setter>
                    </ControlTheme>
                  </controls:BladesArtworkHost.Theme>
                </controls:BladesArtworkHost>
                <Grid x:Name="BladesBootRunnerOverlay" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0" IsHitTestVisible="False" w:Wpf.Visibility="Collapsed" ZIndex="12">
                  <Image x:Name="BladesBootLeftRunnerOpenImage" Width="1920" Height="1080" Stretch="Fill" Opacity="0" Source="{Binding Source=Assets/Blades/Startup/left-runner-open.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1920}"/>
                  <Image x:Name="BladesBootRightRunnerOpenImage" Width="1920" Height="1080" Stretch="Fill" Opacity="0" Source="{Binding Source=Assets/Blades/Startup/right-runner-open.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1920}"/>
                  <Image x:Name="BladesBootLeftRunnerImage" Width="1920" Height="1080" Stretch="Fill" Source="{Binding Source=Assets/Blades/Startup/anim-left-runner.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1920}" RenderTransformOrigin="0%,0%">
                    <Image.RenderTransform>
                      <TranslateTransform/>
                    </Image.RenderTransform>
                  </Image>
                  <Image x:Name="BladesBootRightRunnerImage" Width="1920" Height="1080" Stretch="Fill" Source="{Binding Source=Assets/Blades/Startup/anim-right-runner.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=1920}" RenderTransformOrigin="0%,0%">
                    <Image.RenderTransform>
                      <TranslateTransform/>
                    </Image.RenderTransform>
                  </Image>
                </Grid>
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Fill="{Binding ActiveBladesAccentBrush}" ZIndex="5">
                  <Rectangle.Theme>
                    <ControlTheme TargetType="Rectangle">
                      <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesSubmenuOpen}" Value="True">
                          <w:Setter Property="Visibility" Value="Visible"/>
                        </w:DataTrigger></w:TriggerCollection></Template></Setter>
                    </ControlTheme>
                  </Rectangle.Theme>
                </Rectangle>
                <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0.16" ZIndex="5">
                  <Rectangle.Theme>
                    <ControlTheme TargetType="Rectangle">
                      <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesSubmenuOpen}" Value="True">
                          <w:Setter Property="Visibility" Value="Visible"/>
                        </w:DataTrigger></w:TriggerCollection></Template></Setter>
                    </ControlTheme>
                  </Rectangle.Theme>
                  <Rectangle.Fill>
                    <RadialGradientBrush Center="52%,28%" RadiusX="72%" RadiusY="78%">
                      <GradientStop Color="#EEFFFFFF" Offset="0"/>
                      <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
