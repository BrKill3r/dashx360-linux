                    <Path Canvas.Left="39" Canvas.Top="18" Width="32" Height="33" Stretch="Fill" Fill="#A857A539" Data="M 0,2 C 9,9 13,14 16,22 C 20,14 24,8 32,0 C 25,15 24,22 32,33 C 23,28 18,24 16,19 C 13,24 8,29 0,33 C 8,22 8,15 0,2 Z"/>
                    <TextBlock Canvas.Left="92" Canvas.Top="24" Text="XBOX 360" Foreground="#96416A34" FontSize="32" FontWeight="Normal" FontStretch="Condensed">
                      <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="2" Opacity="0.18" Color="#FFFFFFFF" OffsetX="0.707" OffsetY="0.707"/>
                      </TextBlock.Effect>
                    </TextBlock>
                  </Canvas>
                  <Canvas Canvas.Left="704" Canvas.Top="142" Width="190" Height="102">
                    <Canvas.Theme>
                      <ControlTheme TargetType="Canvas">
                        <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                        <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesXboxLive}" Value="True">
                            <w:Setter Property="Visibility" Value="Visible"/>
                          </w:DataTrigger></w:TriggerCollection></Template></Setter>
                      </ControlTheme>
                    </Canvas.Theme>
                    <Image Width="190" Height="102" Stretch="Uniform" Source="{Binding Source=Assets/Blades/ProvidedIcons/livelogo.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=256}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  </Canvas>
                  <Rectangle Canvas.Left="620" Canvas.Top="256" Width="364" Height="2" Fill="#32345E30">
                    <Rectangle.Theme>
                      <ControlTheme TargetType="Rectangle">
                        <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                        <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesMarketplace}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesSystem}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger></w:TriggerCollection></Template></Setter>
                      </ControlTheme>
                    </Rectangle.Theme>
                  </Rectangle>
                  <TextBlock Canvas.Left="624" Canvas.Top="276" Width="370" Text="{Binding ActiveBladesSelectedItem.DetailTitle}">
                    <TextBlock.Theme>
                      <ControlTheme TargetType="TextBlock" BasedOn="{StaticResource BladeDetailTitleStyle}">
                        <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                        <Setter Property="w:WpfTriggers.ThemeTriggers3"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesMarketplace}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesSystem}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesGames}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesMedia}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesXboxLive}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
