                    <TextBlock Text="{Binding ActiveBladesTitle}" Theme="{StaticResource BladeSectionTitleStyle}"/>
                  </Border>
                  <Border Canvas.Left="206" Canvas.Top="98" Width="386" Height="140" Background="#C4EFE6D6" BorderBrush="#8A405D3B" BorderThickness="1.2" CornerRadius="8" ClipToBounds="True">
                    <Border.Theme>
                      <ControlTheme TargetType="Border">
                        <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                        <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesProfileVisible}" Value="False">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger></w:TriggerCollection></Template></Setter>
                      </ControlTheme>
                    </Border.Theme>
                    <Grid Margin="0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="36"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <Rectangle Grid.Row="1" Opacity="0.20" IsHitTestVisible="False">
                        <Rectangle.Fill>
                          <RadialGradientBrush Center="58%,48%" RadiusX="62%" RadiusY="72%">
                            <GradientStop Color="#7DFFFFFF" Offset="0"/>
                            <GradientStop Color="#1BFFFFFF" Offset="0.55"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                          </RadialGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Rectangle Grid.Row="1" Height="1" VerticalAlignment="Top" Opacity="0.26" IsHitTestVisible="False">
                        <Rectangle.Fill>
                          <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                            <GradientStop Color="#00FFFFFF" Offset="0"/>
                            <GradientStop Color="#FFFFFFFF" Offset="0.48"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                          </LinearGradientBrush>
                        </Rectangle.Fill>
                      </Rectangle>
                      <Border Background="#66F5CC52" Grid.Row="0">
                        <TextBlock Text="{Binding Profile.Gamertag}" Margin="12,0,30,0" TextTrimming="CharacterEllipsis" Theme="{StaticResource BladeProfileGamertagStyle}"/>
                      </Border>
                      <Image Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Width="20" Height="27" Margin="0,0,12,0" Stretch="Uniform" Source="{Binding Source=Assets/Blades/ProvidedIconsFit/xbox live/Friends.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                      <Grid Grid.Row="1" Margin="14,8,10,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="84"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="78" Height="78" BorderBrush="#7D5F6A62" BorderThickness="2" Background="#33FFFFFF" HorizontalAlignment="Left">
                          <Image Stretch="UniformToFill" Source="{Binding Profile.GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                        </Border>
                        <Grid Grid.Column="1">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                            <RowDefinition Height="27"/>
                          </Grid.RowDefinitions>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Rep" Margin="0,-1,0,0" Theme="{StaticResource BladeProfileTextStyle}"/>
                          <StackPanel HorizontalAlignment="Right" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,-1,0,0">
                            <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="25" Foreground="#FFD2BD29" Width="24" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="1" Opacity="0.8" Color="#FF645727" OffsetX="0.707" OffsetY="0.707"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="25" Foreground="#FFD2BD29" Width="24" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="1" Opacity="0.8" Color="#FF645727" OffsetX="0.707" OffsetY="0.707"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="25" Foreground="#FFD2BD29" Width="24" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="1" Opacity="0.8" Color="#FF645727" OffsetX="0.707" OffsetY="0.707"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="25" Foreground="#FFD2BD29" Width="24" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="1" Opacity="0.8" Color="#FF645727" OffsetX="0.707" OffsetY="0.707"/></TextBlock.Effect></TextBlock>
                            <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="25" Foreground="#FFD2BD29" Width="24" VerticalAlignment="Center"><TextBlock.Effect><DropShadowEffect BlurRadius="1" Opacity="0.8" Color="#FF645727" OffsetX="0.707" OffsetY="0.707"/></TextBlock.Effect></TextBlock>
                          </StackPanel>
                          <StackPanel Grid.Row="1" Orientation="Horizontal"><Image Width="24" Height="24" Source="{Binding Source=Assets/Blades/ProvidedIcons/profile/GScore.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}"/><TextBlock Text="amerscore" Theme="{StaticResource BladeProfileTextStyle}"/></StackPanel>
                          <StackPanel HorizontalAlignment="Right" Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="1,0,0,0">
                            <TextBlock Text="{Binding Profile.Gamerscore}" Margin="0,0,5,0" Theme="{StaticResource BladeProfileTextStyle}"/>
                          </StackPanel>
                          <TextBlock Grid.Row="2" Text="Zone" Theme="{StaticResource BladeProfileTextStyle}"/>
                          <TextBlock HorizontalAlignment="Right" Grid.Row="2" Grid.Column="1" Text="Recreation" Margin="1,0,0,0" Theme="{StaticResource BladeProfileTextStyle}"/>
                        </Grid>
                      </Grid>
                    </Grid>
                  </Border>
                  <Canvas Width="330" Height="132">
                    <Canvas.Theme>
                      <ControlTheme TargetType="Canvas">
                        <Setter Property="Canvas.Left" Value="637"/>
                        <Setter Property="Canvas.Top" Value="104"/>
                        <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                        <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesXboxLive}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesMarketplace}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesSystem}" Value="True">
                            <w:Setter Property="Visibility" Value="Collapsed"/>
                          </w:DataTrigger><w:DataTrigger Binding="{Binding IsActiveBladesMedia}" Value="True">
                            <w:Setter Property="Canvas.Left" Value="637"/>
                            <w:Setter Property="Canvas.Top" Value="105"/>
                          </w:DataTrigger></w:TriggerCollection></Template></Setter>
                      </ControlTheme>
                    </Canvas.Theme>
                    <Image Width="330" Height="132" Stretch="Uniform" Source="{Binding Source=Assets/Misc/xbox-360-1.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=420}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                  </Canvas>
                  <Canvas Canvas.Left="724" Canvas.Top="130" Width="230" Height="106">
                    <Canvas.Theme>
                      <ControlTheme TargetType="Canvas">
                        <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                        
                      </ControlTheme>
                    </Canvas.Theme>
                    <Ellipse Canvas.Left="24" Canvas.Top="6" Width="58" Height="58" Stroke="#777A8A74" StrokeThickness="1.4">
                      <Ellipse.Fill>
                        <RadialGradientBrush Center="35%,25%" RadiusX="70%" RadiusY="70%">
