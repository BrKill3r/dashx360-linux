                      </ControlTheme>
                    </TextBlock.Theme>
                  </TextBlock>
                  <TextBlock Canvas.Left="638" Canvas.Top="304" Width="430" Text="Games. Tournaments&#10;Entertainment. All the&#10;rewards. Endless possibilities.&#10;What are you waiting for?">
                    <TextBlock.Theme>
                      <ControlTheme TargetType="TextBlock" BasedOn="{StaticResource BladeBodyTextStyle}">
