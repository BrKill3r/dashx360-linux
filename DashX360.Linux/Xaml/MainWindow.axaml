                              <RectangleGeometry Rect="0,0,1280,720"/>
                            </w:Setter.Value>
                          </w:Setter>
                        </w:DataTrigger></w:TriggerCollection></Template></Setter>
                    </ControlTheme>
                  </Canvas.Theme>
                  <Canvas.RenderTransform>
                    <ScaleTransform ScaleX="1.5" ScaleY="1.5"/>
                  </Canvas.RenderTransform>
                  <Grid Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720">
                <Grid.Theme>
                  <ControlTheme TargetType="Grid">
                    <Setter Property="w:Wpf.Visibility" Value="Visible"/>
                    <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsBladesSubmenuOpen}" Value="True">
                        <w:Setter Property="Visibility" Value="Collapsed"/>
                      </w:DataTrigger></w:TriggerCollection></Template></Setter>
                  </ControlTheme>
                </Grid.Theme>
                <Canvas>
