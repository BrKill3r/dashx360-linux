                </Rectangle>
                <controls:BladeAmbientTexture Width="1920" Height="1080" Tint="{Binding ActiveBladesAccentBrush.Color}" ZIndex="5" w:Wpf.Visibility="{Binding IsBladesSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <Canvas x:Name="BladesContentCanvas" Width="1280" Height="720" ZIndex="6" RenderTransformOrigin="0%,0%">
                  <Canvas.Theme>
                    <ControlTheme TargetType="Canvas">
                      <Setter Property="Canvas.Left" Value="20"/>
                      <Setter Property="Clip">
                        <Setter.Value>
                          <RectangleGeometry Rect="180,0,820,720"/>
                        </Setter.Value>
                      </Setter>
                      <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Binding="{Binding IsActiveBladesMarketplace}" Value="True">
                          <w:Setter Property="Canvas.Left" Value="-50"/>
                          <w:Setter Property="Clip">
                            <w:Setter.Value>
