              <ControlTemplate TargetType="ListBoxItem">
                <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC8D0D3" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Row" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
