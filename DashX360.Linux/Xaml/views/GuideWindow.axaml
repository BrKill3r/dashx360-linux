<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="using:XboxMetroLauncher.Controls" xmlns:input="using:XboxMetroLauncher.Input" xmlns:views="using:XboxMetroLauncher.Views" x:Class="XboxMetroLauncher.Views.GuideWindow" Width="1280" Height="720" Background="#00FFFFFF" ShowInTaskbar="False" Topmost="True" TextInput="Window_OnTextInput" xmlns:w="using:XboxMetroLauncher.Compat" SystemDecorations="None" TransparencyLevelHint="Transparent">
  <Grid Name="GuideRoot" Background="#E6000000">
    <Grid.Resources>
      <ResourceDictionary>
        <ControlTheme x:Key="GuideMediaTransportButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Width" Value="65"/>
          <Setter Property="Height" Value="38"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Foreground" Value="#FF34383A"/>
          <Setter Property="Background" Value="#FFE9EEEE"/>
          <Setter Property="BorderBrush" Value="#FFBBC3C6"/>
          <Setter Property="BorderThickness" Value="0,0,1,0"/>
          
          <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <TextBlock FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding Icon}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideMediaSongRowButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Height" Value="42"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF34383A"/>
          <Setter Property="Background" Value="#FFE5EAEB"/>
          <Setter Property="BorderBrush" Value="#FFBBC3C6"/>
          <Setter Property="BorderThickness" Value="0,0,0,1"/>
          
          <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
          <Setter Property="FontSize" Value="19"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsMediaSongRowFocused}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter Margin="18,0,13,0" HorizontalAlignment="Stretch" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideSubmenuItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Height" Value="38"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF333638"/>
          <Setter Property="Background" Value="#FFE5EAEB"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC0C8CA" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
