          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuidePartyRowStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Height" Value="44"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF202428"/>
          <Setter Property="Background" Value="#FFF7F9FA"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC7CFD2" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Row" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger><w:DataTrigger Value="Disabled" Binding="{Binding RowKind}">
                    <w:Setter Property="Foreground" Value="#FF8F979C"/>
                  </w:DataTrigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideFriendProfileActionStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Height" Value="41"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF2A3033"/>
          <Setter Property="Background" Value="#FFF1F4F5"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC6CED1" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Row" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideKeyboardButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Height" Value="34"/>
          <Setter Property="Margin" Value="2"/>
          <Setter Property="Foreground" Value="#FF34383A"/>
          <Setter Property="Background" Value="#FFF0F3F4"/>
          <Setter Property="BorderBrush" Value="#FFBFC7CA"/>
          <Setter Property="BorderThickness" Value="1"/>
          
          <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
          <Setter Property="FontSize" Value="16"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding Label}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideSearchUtilityButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Height" Value="38"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF34383A"/>
          <Setter Property="Background" Value="#FFF0F3F4"/>
          <Setter Property="BorderBrush" Value="#FFBFC7CA"/>
          <Setter Property="BorderThickness" Value="1"/>
          
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideSearchKeyboard360Style" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Height" Value="28"/>
          <Setter Property="Margin" Value="1"/>
          <Setter Property="Foreground" Value="#FF40474B"/>
          <Setter Property="Background" Value="#FFF2F4F5"/>
          <Setter Property="BorderBrush" Value="#FFA8B0B4"/>
          <Setter Property="BorderThickness" Value="1"/>
          
          <Setter Property="FontFamily" Value="avares://DashX360/Fonts#Selawik"/>
          <Setter Property="FontSize" Value="13"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding IsPressedVisual}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="IsPressed" Value="True">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{TemplateBinding Foreground}" Text="{Binding Label}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideSearchUtility360Style" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Height" Value="58"/>
          <Setter Property="Margin" Value="0"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF3F464A"/>
          <Setter Property="Background" Value="#FFF1F3F4"/>
          <Setter Property="BorderBrush" Value="#FFB3BBC0"/>
          <Setter Property="BorderThickness" Value="1"/>
          
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsSelected}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="#FFF1F3F4"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderThickness" Value="2"/>
                    <w:Setter Property="Foreground" Value="#FF3F464A"/>
                  </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding IsPressedVisual}">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:DataTrigger><w:Trigger Property="IsPressed" Value="True">
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger><w:Trigger Property="UIElement.IsMouseOver" Value="True">
                    <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideFriendProfileOverlayActionStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
          <Setter Property="Height" Value="44"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Foreground" Value="#FF2D3336"/>
          <Setter Property="Background" Value="#FFF4F5F6"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ListBoxItem">
                <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC8CFD2" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                    <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Row" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideOverlayFooterStyle" TargetType="ContentControl">
          <Setter Property="HorizontalAlignment" Value="Left"/>
          <Setter Property="VerticalAlignment" Value="Top"/>
          <Setter Property="Margin" Value="24,6,0,0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ContentControl">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FF61B13F" VerticalAlignment="Center">
                      <TextBlock Text="A" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text=" Select" Foreground="#FFE8EAEB" FontSize="18" VerticalAlignment="Center" Margin="7,0,22,0"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFD63D3D" VerticalAlignment="Center">
                      <TextBlock Text="B" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text=" Back" Foreground="#FFE8EAEB" FontSize="18" VerticalAlignment="Center" Margin="7,0,22,0"/>
                  </StackPanel>
                  <Grid VerticalAlignment="Center" w:Wpf.Visibility="{Binding ShowFooterXAction, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="FooterXHint_OnMouseLeftButtonUp">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="20" Height="20" CornerRadius="10" Background="#FF2574AA" VerticalAlignment="Center">
                        <TextBlock Text="X" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <TextBlock Foreground="#FFE8EAEB" FontSize="18" VerticalAlignment="Center" Margin="7,0,22,0" Text="{Binding FooterXActionText}"/>
                    </StackPanel>
                  </Grid>
                  <StackPanel Orientation="Horizontal" Cursor="Hand" VerticalAlignment="Center" w:Wpf.Visibility="{Binding ShowFooterYAction, Converter={StaticResource BooleanToVisibilityConverter}}" PointerReleased="MinimizeDashboardHint_OnMouseLeftButtonUp">
                    <Border Width="20" Height="20" CornerRadius="10" Background="#FFD8B830" VerticalAlignment="Center">
                      <TextBlock Text="Y" Foreground="#FFFFFFFF" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Foreground="#FFE8EAEB" FontSize="18" VerticalAlignment="Center" Margin="7,0,0,0" Text="{Binding FooterYActionText}"/>
                  </StackPanel>
                </StackPanel>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideMusicPlayerButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Foreground" Value="#FF333333"/>
          <Setter Property="Background" Value="#FFE8ECEC"/>
          <Setter Property="BorderBrush" Value="#55FFFFFF"/>
          <Setter Property="BorderThickness" Value="1"/>
          
          <Setter Property="FontSize" Value="17"/>
          <Setter Property="FontWeight" Value="SemiBold"/>
          <Setter Property="Padding" Value="4,0"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Border Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                    <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                    <w:Setter Property="Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                    <w:Setter Property="BorderBrush" Value="#00FFFFFF"/>
                    <w:Setter Property="BorderThickness" Value="0"/>
                  </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                    <w:Setter Property="Background" Value="{w:DynRes MetroGreenBrush}"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                </Border>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
        <ControlTheme x:Key="GuideMusicTrackButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="VerticalAlignment" Value="Stretch"/><Setter Property="HorizontalAlignment" Value="Stretch"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="BorderThickness" Value="0"/>
          <Setter Property="Background" Value="#00FFFFFF"/>
          
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="VerticalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="Button">
                <Grid><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                    <w:Setter TargetName="FocusFrame" Property="UIElement.Opacity" Value="1"/>
                    <w:Setter Property="Panel.ZIndex" Value="10"/>
                  </w:Trigger><w:Trigger Property="IsPressed" Value="True">
                    <w:Setter Property="UIElement.Opacity" Value="0.82"/>
                  </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                  <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                  <Border Name="FocusFrame" BorderBrush="{DynamicResource MetroGreenBrush}" BorderThickness="4" Opacity="0"/>
                </Grid>
                
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </ControlTheme>
      </ResourceDictionary>
    </Grid.Resources>
    <Viewbox Name="GuideContent" Stretch="Uniform" RenderTransformOrigin="50%,50%">
      <Viewbox.RenderTransform>
        <TransformGroup>
          <ScaleTransform ScaleX="1" ScaleY="1"/>
          <TranslateTransform Y="-8"/>
        </TransformGroup>
      </Viewbox.RenderTransform>
      <Canvas Width="1280" Height="720">
        <TextBlock Text="Xbox Guide" Canvas.Left="354" Canvas.Top="165" Foreground="#FFE8EAEB" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="23" FontWeight="Light"/>
        <Image Canvas.Left="607" Canvas.Top="146" Width="48" Height="48" Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
        <StackPanel Canvas.Left="802" Canvas.Top="153" Orientation="Horizontal">
          <Grid Width="32" Height="18" Margin="0,2,18,0">
            <Border Width="25" Height="12" HorizontalAlignment="Left" VerticalAlignment="Center" BorderBrush="#FFE1E5E6" BorderThickness="2"/>
            <Border Width="4" Height="8" HorizontalAlignment="Right" Margin="0,0,2,0" Background="#FFE1E5E6" VerticalAlignment="Center"/>
            <Rectangle Width="16" Height="6" Fill="#FFE1E5E6" HorizontalAlignment="Left" Margin="4,0,0,0"/>
          </Grid>
          <Ellipse Width="22" Height="22" Stroke="{DynamicResource MetroGreenBrush}" StrokeThickness="2" Margin="0,0,14,0"/>
        </StackPanel>
        <TextBlock Canvas.Left="777" Canvas.Top="179" Width="126" TextAlignment="Center" Foreground="#FFE8EAEB" FontSize="21" FontWeight="SemiBold" Text="{Binding ClockText}"/>
        <Grid Canvas.Left="314" Canvas.Top="204" Width="694" w:Wpf.Visibility="{Binding IsGuideBladeScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RowDefinitions>
            <RowDefinition Height="315"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Name="GuideBladePanel" Row="0" Width="694" Height="315" RenderTransformOrigin="50%,50%">
            <Grid.RenderTransform>
              <TranslateTransform/>
            </Grid.RenderTransform>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="48"/>
              <ColumnDefinition Width="58"/>
              <ColumnDefinition Width="490"/>
              <ColumnDefinition Width="53"/>
              <ColumnDefinition Width="45"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#FFBBC6CC" BorderBrush="#FF9BA5AA" BorderThickness="0,0,1,0" PointerPressed="LeftOuterTab_OnMouseLeftButtonDown">
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center"><LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90"/>
                </LayoutTransformControl.LayoutTransform><TextBlock Foreground="#FF4A555D" FontSize="20" FontWeight="SemiBold" Text="{Binding LeftOuterTabText}">
                
              </TextBlock></LayoutTransformControl>
            </Border>
            <Border Grid.Column="1" Background="#FFE8EEEE" BorderBrush="#FFBDC5C8" BorderThickness="0,0,1,0" PointerPressed="LeftInnerTab_OnMouseLeftButtonDown">
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center"><LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90"/>
                </LayoutTransformControl.LayoutTransform><TextBlock Foreground="#FF3C4144" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding LeftInnerTabText}">
                
              </TextBlock></LayoutTransformControl>
            </Border>
            <Grid Column="2" Background="#FFE5EAEB">
              <Grid Name="MainGuidePanel" w:Wpf.Visibility="{Binding IsMainGuideScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ListBox Name="GuideMenu" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding Items}" SelectedIndex="{Binding GuideMenuVisualSelectedIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerReleased="GuideMenu_OnMouseLeftButtonUp">
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Height" Value="42"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Foreground" Value="#FF333638"/>
                      <Setter Property="Background" Value="#FFE5EAEB"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFC0C8CA" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                                <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                                <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                              </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                              <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                            </Border>
                            
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="18,0,13,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="42"/>
                          <ColumnDefinition Width="32"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Grid.Column="1" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Count}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Grid.Column="2" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="21" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding Icon}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Border Height="147" VerticalAlignment="Bottom" Background="#E5E9EDEE" BorderBrush="#FFB9C2C5" BorderThickness="0,1,0,0" w:Wpf.Visibility="{Binding IsMediaTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="*"/>
                      <RowDefinition Height="42"/>
                      <RowDefinition Height="58"/>
                    </Grid.RowDefinitions>
                    <Button Name="MediaSongRowButton" Grid.Row="1" Command="{Binding OpenGuideMusicMenuCommand}" Theme="{StaticResource GuideMediaSongRowButtonStyle}">
                      <TextBlock TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Text="{Binding GuideMediaPlaybackLabel}"/>
                    </Button>
                    <ItemsControl Name="MediaTransportItems" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" ItemsSource="{Binding MediaControls}">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Command="{Binding DataContext.ActivateMediaControlCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideMediaTransportButtonStyle}"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </Grid>
                </Border>
                <Grid Name="MediaSubmenuBlade" ZIndex="8" Background="#FFE5EAEB" w:Wpf.Visibility="{Binding IsMediaSubmenuOpen, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
                  <Grid.RenderTransform>
                    <TranslateTransform X="24"/>
                  </Grid.RenderTransform>
                  <ListBox Name="MediaSubmenuList" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding MediaSubmenuItems}" SelectedIndex="{Binding SelectedMediaSubmenuIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideSubmenuItemStyle}" PointerReleased="MediaSubmenu_OnMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="18,0,13,0">
                          <TextBlock FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <Grid Name="GuideMusicPickerPanel" Background="#FFE5EAEB" w:Wpf.Visibility="Collapsed">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="28"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="#FFE9EDEE" BorderBrush="#FFC0C8CA" BorderThickness="0,0,0,1">
                    <Grid Margin="18,0,13,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <TextBlock FontSize="13" Foreground="#FF6A7377" VerticalAlignment="Center" Text="{Binding GuideMusicPickerHeaderText}"/>
                      <TextBlock Grid.Row="1" FontSize="17" FontWeight="SemiBold" Foreground="#FF333638" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding GuideMusicPickerCurrentTitle}"/>
                    </Grid>
                  </Border>
                  <ListBox Name="GuideMusicPickerListBox" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding GuideMusicTracks}" SelectedIndex="{Binding SelectedGuideMusicTrackIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideSubmenuItemStyle}" PointerReleased="GuideMusicPicker_OnMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="18,0,13,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="26"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="?" Grid.Column="0" FontSize="14" Foreground="{DynamicResource MetroGreenBrush}" VerticalAlignment="Center" w:Wpf.Visibility="{Binding IsPlaying, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                          <TextBlock Grid.Column="1" FontFamily="avares://DashX360/Fonts#Selawik" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                  <Border Grid.Row="2" Background="#FFE9EDEE" BorderBrush="#FFC0C8CA" BorderThickness="0,1,0,0">
                    <TextBlock Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#FF5E666A" FontSize="14" Text="{Binding GuideMusicPickerCountText}"/>
                  </Border>
                </Grid>
              </Grid>
              <Grid Name="FriendsListPanel" Background="#FFE8EDEE" w:Wpf.Visibility="{Binding IsFriendsListScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="34"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="28"/>
                </Grid.RowDefinitions>
                <Grid Row="0" Background="#FFCDD6DB">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="84"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="74"/>
                    <ColumnDefinition Width="74"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Background="#FF707A82" BorderBrush="#FFBDC5C8" BorderThickness="0,0,1,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="🗝" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="14" Foreground="#FFFFFFFF" Margin="0,0,6,0"/>
                      <TextBlock FontSize="13" Foreground="#FFFFFFFF" Text="{Binding FriendsHeaderText}"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="1" Background="#FFF4F7F8" BorderBrush="#FFBDC5C8" BorderThickness="0,0,1,1">
                    <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#FF333638" VerticalAlignment="Center" Margin="18,0,0,0" Text="{Binding FriendsHeaderText}"/>
                  </Border>
                  <Border Grid.Column="2" Background="#FF707A82" BorderBrush="#FFBDC5C8" BorderThickness="0,0,1,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="🗩" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="13" Foreground="#FFFFFFFF" Margin="0,0,4,0"/>
                      <TextBlock Text="0" FontSize="13" Foreground="#FFFFFFFF"/>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Background="#FF707A82" BorderBrush="#FFBDC5C8" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="13" Foreground="#FFFFFFFF" Margin="0,0,4,0"/>
                      <TextBlock Text="0" FontSize="13" Foreground="#FFFFFFFF"/>
                    </StackPanel>
                  </Border>
                </Grid>
                <ListBox Name="FriendsListBox" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding FriendsListItems}" SelectedIndex="{Binding SelectedFriendListIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideFriendsRowStyle}" PointerReleased="FriendsList_OnMouseLeftButtonUp">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="14,0,14,0"><w:WpfTriggers.DataTemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsAddFriend}">
                          <w:Setter TargetName="FriendRow" Property="UIElement.Visibility" Value="Collapsed"/>
                          <w:Setter TargetName="AddFriendRow" Property="UIElement.Visibility" Value="Visible"/>
                        </w:DataTrigger></w:TriggerCollection></w:WpfTriggers.DataTemplateTriggers>
                        <Grid Name="FriendRow">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="560"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="40" Height="40" Background="#FFD4DBDE" BorderBrush="#FFB8C0C4" BorderThickness="1" VerticalAlignment="Center">
                            <Image Stretch="UniformToFill" Source="{Binding AvatarPath, Converter={StaticResource StringToImageSourceConverter}}"/>
                          </Border>
                          <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Gamertag}"/>
                            <TextBlock FontSize="12" Margin="0,2,0,0" Opacity="0.82" Text="{Binding Subtitle}"/>
                          </StackPanel>
                          <TextBlock Grid.Column="2" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="126,0,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Status}"/>
                        </Grid>
                        <Grid Name="AddFriendRow" w:Wpf.Visibility="Collapsed">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="🗝" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="30" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                          <TextBlock Grid.Column="1" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,0" Text="{Binding Gamertag}"/>
                        </Grid>
                      </Grid>
                      
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="2" Margin="14,4,0,0" Foreground="#FF555E64" FontSize="12" Text="{Binding FriendsFooterText}"/>
              </Grid>
              <Grid Name="FriendSearchPanel" Background="#FFE3E8E9" w:Wpf.Visibility="{Binding IsFriendSearchScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="34"/>
                  <RowDefinition Height="60"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Background="#FF22292D">
                  <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="17" FontWeight="SemiBold" Text="{Binding FriendSearchHeaderText}"/>
                </Border>
                <StackPanel Grid.Row="1" Margin="18,12,18,0">
                  <TextBlock Foreground="#FF5D666C" FontSize="13" Text="{Binding FriendSearchInstructionText}"/>
                  <Border Margin="0,10,0,0" Height="34" Background="#FFFFFFFF" BorderBrush="#FFBFC7CA" BorderThickness="1">
                    <TextBlock Margin="10,0,10,0" VerticalAlignment="Center" FontSize="17" Foreground="#FF333638" Text="{Binding FriendSearchQuery}"/>
                  </Border>
                </StackPanel>
                <Grid Row="2" Margin="18,10,18,16">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="48"/>
                  </Grid.RowDefinitions>
                  <ItemsControl Name="SearchMainKeysItems" ItemsSource="{Binding SearchMainKeys}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="10"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideKeyboardButtonStyle}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl Name="SearchActionKeysItems" Grid.Row="1" ItemsSource="{Binding SearchActionKeys}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button MinWidth="86" FontSize="14" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideKeyboardButtonStyle}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Grid>
              <Grid Name="FriendProfilePanel" Background="#FFE6EBEC" w:Wpf.Visibility="{Binding IsFriendProfileScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="248"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="#FFF5F7F8" BorderBrush="#FFC0C8CA" BorderThickness="0,0,1,1">
                    <TextBlock Text="Gamer Profile" Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#FF333638" FontSize="16" FontWeight="SemiBold"/>
                  </Border>
                  <ListBox Name="FriendProfileActionsList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding FriendProfileActions}" SelectedIndex="{Binding SelectedFriendProfileActionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideFriendProfileActionStyle}" PointerReleased="FriendProfileActions_OnMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="14,0,10,0">
                          <TextBlock FontSize="17" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <Grid Column="1" Background="#FFD8DEE0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="#FF98A2A8" BorderBrush="#FFC0C8CA" BorderThickness="0,0,0,1">
                    <TextBlock Text="Personal Profile" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="16" FontWeight="SemiBold"/>
                  </Border>
                  <Grid Row="1" Margin="14,12,14,14">
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock FontSize="18" FontWeight="SemiBold" Foreground="#FF333638" Text="{Binding ActiveFriendGamertag}"/>
                    <Grid Row="1" Margin="0,10,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="64" Height="64" Background="#FFBCC4C8" BorderBrush="#FFA6AFB3" BorderThickness="1">
                        <Image Stretch="UniformToFill" Source="{Binding ActiveFriendPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                      </Border>
                      <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Foreground="#FFDF7D25" FontSize="16" Text="{Binding ActiveFriendReputation}"/>
                        <Grid Margin="0,6,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Gamerscore" Foreground="#FF444D52" FontSize="15"/>
                          <TextBlock Grid.Column="1" Foreground="#FF333638" FontSize="15" Text="{Binding ActiveFriendGamerscore}"/>
                        </Grid>
                        <Grid Margin="0,2,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <TextBlock Text="Zone" Foreground="#FF444D52" FontSize="15"/>
                          <TextBlock Grid.Column="1" Foreground="#FF333638" FontSize="15" Text="{Binding ActiveFriendZone}"/>
                        </Grid>
                      </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="2" Margin="0,18,0,0">
                      <TextBlock FontSize="15" Foreground="#FF444D52" Text="{Binding ActiveFriendCountry}"/>
                      <TextBlock Margin="0,14,0,0" FontSize="17" Foreground="#FF444D52" Text="{Binding ActiveFriendStatus}"/>
                    </StackPanel>
                  </Grid>
                </Grid>
              </Grid>
            </Grid>
            <Border Grid.Column="3" Background="#FF47545D" BorderBrush="#FF3E4A52" BorderThickness="1,0,0,0" PointerPressed="RightInnerTab_OnMouseLeftButtonDown">
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center"><LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90"/>
                </LayoutTransformControl.LayoutTransform><TextBlock Foreground="#FFDDE2E4" FontSize="21" Text="{Binding RightInnerTabText}">
                
              </TextBlock></LayoutTransformControl>
            </Border>
            <Border Grid.Column="4" Background="#FFBBC6CC" PointerPressed="RightOuterTab_OnMouseLeftButtonDown">
              <LayoutTransformControl HorizontalAlignment="Center" VerticalAlignment="Center"><LayoutTransformControl.LayoutTransform>
                  <RotateTransform Angle="90"/>
                </LayoutTransformControl.LayoutTransform><TextBlock Foreground="#FF4A555D" FontSize="21" FontWeight="SemiBold" Text="{Binding RightOuterTabText}">
                
              </TextBlock></LayoutTransformControl>
            </Border>
          </Grid>
          <ContentControl Grid.Row="1" Margin="22,18,0,0" Theme="{StaticResource GuideOverlayFooterStyle}"/>
        </Grid>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" Fill="#7A000000" IsHitTestVisible="False" w:Wpf.Visibility="{Binding IsFriendsListScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" Fill="#7A000000" IsHitTestVisible="False" w:Wpf.Visibility="{Binding IsAchievementsScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Name="AchievementsOverlay" Canvas.Left="210" Canvas.Top="50" Width="860" Height="606" Opacity="0" RenderTransformOrigin="50%,50%" w:Wpf.Visibility="{Binding IsAchievementsScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
              <TranslateTransform X="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="526"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Name="AchievementsOverlayHeader" Grid.Row="0" Background="#00FFFFFF">
            <Grid Margin="16,0,16,0">
              <TextBlock Foreground="#FFFFFFFF" FontSize="23" VerticalAlignment="Center" Text="{Binding AchievementsHeaderText}"/>
              <Border Width="36" Height="36" Margin="0,-8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFD7DDDF" BorderBrush="#66000000" BorderThickness="1">
                <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
              </Border>
              <TextBlock HorizontalAlignment="Right" Foreground="#FFFFFFFF" FontSize="23" VerticalAlignment="Center" Text="{Binding ClockText}"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#FFE8ECEE" BorderBrush="#FF98A2A8" BorderThickness="1">
            <Grid Name="AchievementsOverlayMenuContent">
              <Grid w:Wpf.Visibility="{Binding IsAchievementGameList, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <ListBox Name="AchievementsGameListBox" Grid.Row="0" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding AchievementGameItems}" SelectedIndex="{Binding SelectedAchievementGameIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerReleased="AchievementGames_OnMouseLeftButtonUp">
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Height" Value="58"/>
                      <Setter Property="Foreground" Value="#FF384047"/>
                      <Setter Property="Background" Value="#FFF1F6F8"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                      
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border Name="Row" Background="{TemplateBinding Background}" BorderBrush="#FFB9C4CB" BorderThickness="0,0,0,1"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                                <w:Setter TargetName="Row" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                                <w:Setter TargetName="Row" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                                <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                              </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                              <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                            </Border>
                            
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Margin="14,0,22,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="52"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="#FF9AA1A5" BorderBrush="#CCFFFFFF" BorderThickness="1" VerticalAlignment="Center" ClipToBounds="True">
                          <Image Stretch="UniformToFill" Source="{Binding CoverArtPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="22" TextTrimming="CharacterEllipsis" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                          <TextBlock FontSize="15" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Opacity="0.92" Text="{Binding CountText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </StackPanel>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Margin="18,0,18,0" VerticalAlignment="Center" Foreground="#FF555E64" FontSize="13"/>
              </Grid>
              <Grid w:Wpf.Visibility="{Binding IsAchievementDetail, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.RowDefinitions>
                  <RowDefinition Height="160"/>
                  <RowDefinition Height="*"/>
                  <RowDefinition Height="36"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" BorderBrush="#FF929A9E" BorderThickness="0,0,0,1">
                  <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                      <GradientStop Color="#FFA8B2B5" Offset="0"/>
                      <GradientStop Color="#FF6E787C" Offset="1"/>
                    </LinearGradientBrush>
                  </Border.Background>
                  <Grid Margin="18,18,22,16">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="190"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Foreground="#FFFFFFFF" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding AchievementsGameTitle}"/>
                      <TextBlock Foreground="#F2FFFFFF" FontSize="25" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" Text="{Binding SelectedAchievementTitle}"/>
                      <TextBlock Foreground="#E5FFFFFF" FontSize="21" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" Text="{Binding SelectedAchievementDescription}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                      <TextBlock HorizontalAlignment="Right" Foreground="#FFFFFFFF" FontSize="24" Text="{Binding SelectedAchievementStatusText}"/>
                      <TextBlock HorizontalAlignment="Right" Foreground="#E8FFFFFF" FontSize="22" Margin="0,8,0,0" Text="{Binding SelectedAchievementDateText}"/>
                    </StackPanel>
                  </Grid>
                </Border>
                <ListBox Name="AchievementsOverlayListBox" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Hidden" ItemsSource="{Binding AchievementItems}" SelectedIndex="{Binding SelectedAchievementIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" PointerReleased="Achievements_OnMouseLeftButtonUp">
                  <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel Margin="62,18,22,0" ItemWidth="97" ItemHeight="104"/>
                    </ItemsPanelTemplate>
                  </ListBox.ItemsPanel>
                  <ListBox.ItemContainerTheme>
                    <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                      <Setter Property="Width" Value="97"/>
                      <Setter Property="Height" Value="104"/>
                      <Setter Property="Margin" Value="0"/>
                      <Setter Property="Foreground" Value="#FF8B9295"/>
                      <Setter Property="Background" Value="#00FFFFFF"/>
                      <Setter Property="HorizontalContentAlignment" Value="Center"/>
                      <Setter Property="VerticalContentAlignment" Value="Center"/>
                      
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ListBoxItem">
                            <Grid Width="97" Height="104"><w:WpfTriggers.TemplateTriggers><w:TriggerCollection><w:Trigger Property="ListBoxItem.IsSelected" Value="True">
                                <w:Setter TargetName="Root" Property="Border.Background" Value="{w:DynRes MetroGreenBrush}"/>
                                <w:Setter TargetName="Root" Property="Border.BorderBrush" Value="{w:DynRes MetroGreenBrush}"/>
                                <w:Setter TargetName="Root" Property="Border.BorderThickness" Value="1"/>
                                <w:Setter Property="Foreground" Value="#FFFFFFFF"/>
                              </w:Trigger></w:TriggerCollection></w:WpfTriggers.TemplateTriggers>
                              <Border Name="Root" Width="78" Height="78" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{TemplateBinding Background}" BorderBrush="#00FFFFFF" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" FontFamily="{TemplateBinding FontFamily}"/>
                              </Border>
                            </Grid>
                            
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </ControlTheme>
                  </ListBox.ItemContainerTheme>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center"><w:WpfTriggers.DataTemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding Achieved}">
                          <w:Setter TargetName="UnlockedIcon" Property="UIElement.Visibility" Value="Visible"/>
                          <w:Setter TargetName="LockedIcon" Property="UIElement.Visibility" Value="Collapsed"/>
                        </w:DataTrigger><w:DataTrigger Value="True" Binding="{Binding HasIconPath}">
                          <w:Setter TargetName="AchievementImageFrame" Property="UIElement.Visibility" Value="Visible"/>
                          <w:Setter TargetName="UnlockedIcon" Property="UIElement.Visibility" Value="Collapsed"/>
                          <w:Setter TargetName="LockedIcon" Property="UIElement.Visibility" Value="Collapsed"/>
                        </w:DataTrigger></w:TriggerCollection></w:WpfTriggers.DataTemplateTriggers>
                        <Border Name="AchievementImageFrame" Width="54" Height="54" Background="#FF252A2C" BorderBrush="#DFFFFFFF" BorderThickness="1" ClipToBounds="True" w:Wpf.Visibility="Collapsed">
                          <Image Stretch="UniformToFill" Source="{Binding IconPath, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=96}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
                        </Border>
                        <Canvas Name="UnlockedIcon" Width="54" Height="54" w:Wpf.Visibility="Collapsed">
                          <Path Stretch="Uniform" Width="42" Height="42" Canvas.Left="6" Canvas.Top="6" Data="M8,2 L22,2 L20,17 C19,22 16,25 15,25 C14,25 11,22 10,17 M3,5 L8,5 L8,9 L5,9 C4,9 4,10 4,11 C4,14 6,16 9,16 L10,20 C4,19 0,15 0,10 C0,7 1,5 3,5 M22,5 L27,5 C29,5 30,7 30,10 C30,15 26,19 20,20 L21,16 C24,16 26,14 26,11 C26,10 26,9 25,9 L22,9 M12,25 L18,25 L18,29 L23,29 L23,32 L7,32 L7,29 L12,29" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Canvas>
                        <Canvas Name="LockedIcon" Width="54" Height="54">
                          <Path Stretch="Uniform" Width="46" Height="48" Canvas.Left="4" Canvas.Top="3" Data="M8,14 L8,10 C8,4 12,0 18,0 C24,0 28,4 28,10 L28,14 L24,14 L24,10 C24,6 22,4 18,4 C14,4 12,6 12,10 L12,14 M4,14 L32,14 L32,32 L4,32" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Canvas>
                      </Grid>
                      
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <Grid Row="2" Margin="18,0,18,0">
                  <TextBlock VerticalAlignment="Center" Foreground="#FF1F2427" FontSize="17" Text="{Binding AchievementsUnlockedText}"/>
                  <TextBlock VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="#FF555E64" FontSize="13" TextTrimming="CharacterEllipsis" Text="{Binding StatusText}"/>
                </Grid>
              </Grid>
            </Grid>
          </Border>
          <ContentControl Name="AchievementsOverlayFooter" Grid.Row="2" Theme="{StaticResource GuideOverlayFooterStyle}"/>
        </Grid>
        <Grid Name="FriendsListOverlay" Canvas.Left="210" Canvas.Top="50" Width="860" Height="606" Opacity="0" RenderTransformOrigin="50%,50%" w:Wpf.Visibility="{Binding IsFriendsListScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
              <TranslateTransform X="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="526"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Name="FriendsOverlayHeader" Grid.Row="0" Background="#00FFFFFF" BorderThickness="0">
            <Grid Margin="16,0,16,0">
              <TextBlock Foreground="#FFFFFFFF" FontSize="18" VerticalAlignment="Center" Text="{Binding FriendsCommunityHeaderText}"/>
              <Border Width="36" Height="36" Margin="0,-8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFD7DDDF" BorderBrush="#66000000" BorderThickness="1">
                <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
              </Border>
              <TextBlock HorizontalAlignment="Right" Foreground="#FFFFFFFF" FontSize="18" VerticalAlignment="Center" Text="{Binding ClockText}"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#FFE8ECEE" BorderBrush="#FF98A2A8" BorderThickness="1">
            <Grid Name="FriendsOverlayMenuContent">
              <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
              </Grid.RowDefinitions>
              <Grid Name="FriendsCommunityTabStrip" Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="130"/>
                  <ColumnDefinition Width="360"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="0,0,1,1" Cursor="Hand" PointerPressed="FriendsPartyTab_OnMouseLeftButtonDown">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🗪" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="22"/>
                  </StackPanel>
                </Border>
                <Border Name="FriendsActiveCommunityTab" Grid.Column="1" Background="#FFF8FAFB" BorderBrush="#FFBDC6CB" BorderThickness="0,0,0,1" RenderTransformOrigin="0%,0%">
                  <Border.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Border.RenderTransform>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="🗪" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FF333638" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FF333638" FontSize="18" Text="{Binding FriendsHeaderText}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="1,0,1,1">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✉" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="18" Text="{Binding PartyMessageCountText}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="18" Text="{Binding PartyGameCountText}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <ListBox Name="FriendsOverlayListBox" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding FriendsListItems}" SelectedIndex="{Binding SelectedFriendListIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideFriendsRowStyle}" PointerReleased="FriendsList_OnMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="12,0,16,0"><w:WpfTriggers.DataTemplateTriggers><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsAddFriend}">
                        <w:Setter TargetName="FriendRow" Property="UIElement.Visibility" Value="Collapsed"/>
                        <w:Setter TargetName="AddFriendRow" Property="UIElement.Visibility" Value="Visible"/>
                      </w:DataTrigger></w:TriggerCollection></w:WpfTriggers.DataTemplateTriggers>
                      <Grid Name="FriendRow">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="64"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="520"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="48" Height="48" Margin="0,2,10,2" Background="#FFB9C1C5" BorderBrush="#FF9EA8AD" BorderThickness="1">
                          <Image Stretch="UniformToFill" Source="{Binding AvatarPath, Converter={StaticResource StringToImageSourceConverter}}"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock FontSize="16.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Text="{Binding Gamertag}"/>
                          <TextBlock FontSize="12" Opacity="0.82" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="124,0,0,0">
                          <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="15" Foreground="#FFE86A2D" Margin="0,0,7,0"/>
                          <TextBlock FontSize="14" TextTrimming="CharacterEllipsis" Text="{Binding Status}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </StackPanel>
                      </Grid>
                      <Grid Name="AddFriendRow" w:Wpf.Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="70"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid Width="54" Height="54" VerticalAlignment="Center">
                          <TextBlock Text="🗪" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="35" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                          <Border Width="18" Height="18" CornerRadius="9" Background="#CCFFFFFF" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                            <TextBlock Text="+" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource MetroGreenBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                        </Grid>
                        <TextBlock Grid.Column="1" FontSize="18" FontWeight="Normal" VerticalAlignment="Center" Margin="8,0,0,0" Text="{Binding Gamertag}"/>
                      </Grid>
                    </Grid>
                    
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <Border Grid.Row="2" Background="#FFF1F4F5" BorderBrush="#FFC7CFD2" BorderThickness="0,1,0,0">
                <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FF525B61" FontSize="12.5" Text="{Binding FriendsFooterText}"/>
              </Border>
            </Grid>
          </Border>
          <ContentControl Name="FriendsOverlayFooter" Grid.Row="2" Theme="{StaticResource GuideOverlayFooterStyle}"/>
        </Grid>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" Fill="#7A000000" IsHitTestVisible="False" w:Wpf.Visibility="{Binding IsPartyScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Name="PartyOverlay" Canvas.Left="210" Canvas.Top="50" Width="860" Height="606" Opacity="0" RenderTransformOrigin="50%,50%" w:Wpf.Visibility="{Binding IsPartyScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
              <TranslateTransform X="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="526"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Border Name="PartyOverlayHeader" Grid.Row="0" Background="#00FFFFFF" BorderThickness="0">
            <Grid Margin="16,0,16,0">
              <TextBlock Foreground="#FFFFFFFF" FontSize="18" VerticalAlignment="Center" Text="{Binding FriendsCommunityHeaderText}"/>
              <Border Width="36" Height="36" Margin="0,-8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFD7DDDF" BorderBrush="#66000000" BorderThickness="1">
                <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
              </Border>
              <TextBlock HorizontalAlignment="Right" Foreground="#FFFFFFFF" FontSize="18" VerticalAlignment="Center" Text="{Binding ClockText}"/>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="#FFE8ECEE" BorderBrush="#FF98A2A8" BorderThickness="1">
            <Grid Name="PartyOverlayMenuContent">
              <Grid.RowDefinitions>
                <RowDefinition Height="50"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid Name="PartyCommunityTabStrip" Row="0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="360"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Name="PartyActiveCommunityTab" Background="#FFF8FAFB" BorderBrush="#FFBDC6CB" BorderThickness="0,0,1,1" RenderTransformOrigin="0%,0%">
                  <Border.RenderTransform>
                    <TranslateTransform X="0"/>
                  </Border.RenderTransform>
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <TextBlock Text="🗪" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FF333638" FontSize="22" Margin="0,0,10,0"/>
                    <TextBlock Foreground="#FF333638" FontSize="18.5" Text="{Binding PartyHeaderText}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="1" Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="0,0,1,1" Cursor="Hand" PointerPressed="PartyFriendsTab_OnMouseLeftButtonDown">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="18" Text="{Binding PartyFriendCountText}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="2" Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="0,0,1,1">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="✉" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="18" Text="{Binding PartyMessageCountText}"/>
                  </StackPanel>
                </Border>
                <Border Grid.Column="3" Background="#FF6E7881" BorderBrush="#FF97A2A9" BorderThickness="0,0,0,1">
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="🎮" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#FFFFFFFF" FontSize="18" Margin="0,0,7,0"/>
                    <TextBlock Foreground="#FFFFFFFF" FontSize="18" Text="{Binding PartyGameCountText}"/>
                  </StackPanel>
                </Border>
              </Grid>
              <ListBox Name="PartyOverlayListBox" Grid.Row="1" Background="#FFF7F9FA" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding PartyRows}" SelectedIndex="{Binding SelectedPartyRowIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuidePartyRowStyle}" PointerReleased="PartyRows_OnMouseLeftButtonUp">
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="14,0,12,0"><w:WpfTriggers.DataTemplateTriggers><w:TriggerCollection><w:DataTrigger Value="Member" Binding="{Binding RowKind}">
                        <w:Setter TargetName="TitleRow" Property="UIElement.Visibility" Value="Collapsed"/>
                        <w:Setter TargetName="MemberRow" Property="UIElement.Visibility" Value="Visible"/>
                      </w:DataTrigger><w:DataTrigger Value="Disabled" Binding="{Binding RowKind}">
                        <w:Setter TargetName="TitleRowText" Property="TextBlock.Foreground" Value="#FF9AA2A7"/>
                      </w:DataTrigger><w:DataTrigger Value="Options" Binding="{Binding RowKind}">
                        <w:Setter TargetName="TitleRowText" Property="TextBlock.FontSize" Value="16"/>
                      </w:DataTrigger></w:TriggerCollection></w:WpfTriggers.DataTemplateTriggers>
                      <Grid Name="TitleRow">
                        <TextBlock Name="TitleRowText" FontSize="18" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                      </Grid>
                      <Grid Name="MemberRow" w:Wpf.Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="34"/>
                          <ColumnDefinition Width="44"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="30"/>
                          <ColumnDefinition Width="240"/>
                          <ColumnDefinition Width="28"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🎙" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" w:Wpf.Visibility="{Binding ShowVoiceIcon, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <Border Grid.Column="1" Width="34" Height="34" Background="#FFB9C1C5" BorderBrush="#FF9EA8AD" BorderThickness="1" VerticalAlignment="Center">
                          <Image Stretch="UniformToFill" Source="{Binding AvatarPath, Converter={StaticResource StringToImageSourceConverter}}"/>
                        </Border>
                        <TextBlock Grid.Column="2" Margin="10,0,0,0" FontSize="17" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Grid.Column="3" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="17" Foreground="{DynamicResource MetroGreenBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" Text="{Binding ActivityIcon}"/>
                        <TextBlock Grid.Column="4" Margin="8,0,0,0" FontSize="17" VerticalAlignment="Center" Text="{Binding ActivityText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        <TextBlock Grid.Column="5" Text="★" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" w:Wpf.Visibility="{Binding IsHost, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                      </Grid>
                    </Grid>
                    
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Grid>
          </Border>
          <ContentControl Name="PartyOverlayFooter" Grid.Row="2" Theme="{StaticResource GuideOverlayFooterStyle}"/>
        </Grid>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" Fill="#76000000" IsHitTestVisible="False" w:Wpf.Visibility="{Binding IsFriendSearchScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Name="FriendSearchOverlay" Canvas.Left="208" Canvas.Top="64" Width="864" Height="590" Opacity="0" w:Wpf.Visibility="{Binding IsFriendSearchScreen, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
          <Grid.RenderTransform>
            <TranslateTransform X="0"/>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="34"/>
            <RowDefinition Height="526"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="28,0,28,0">
            <TextBlock Foreground="#FFFFFFFF" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Text="{Binding FriendSearchHeaderText}"/>
            <Border Width="36" Height="36" Margin="0,-12,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FFD8DDDF" BorderBrush="#B3000000" BorderThickness="1">
              <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
            </Border>
            <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="22" Text="{Binding ClockText}"/>
          </Grid>
          <Border Grid.Row="1" BorderBrush="#FF919B9F" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="22" Color="#FF000000" Opacity="0.48" OffsetX="0" OffsetY="0"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="224"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Color="#FF9CA1A6" Offset="0"/>
                    <GradientStop Color="#FFAEB3B7" Offset="0.55"/>
                    <GradientStop Color="#FFC1C6C9" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid Width="800" HorizontalAlignment="Center">
                  <TextBlock Margin="0,32,0,0" VerticalAlignment="Top" Foreground="#FFF4F5F6" FontSize="18" FontWeight="SemiBold" Opacity="0.95" Text="{Binding FriendSearchInstructionText}"/>
                  <Border Width="712" Height="43" Margin="0,150,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFFFFFFF" BorderBrush="#FFB2BABE" BorderThickness="1" ClipToBounds="True">
                    <TextBlock Margin="12,0,12,1" VerticalAlignment="Center" FontSize="26" Foreground="#FF303639" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding FriendSearchDisplayText}"/>
                  </Border>
                </Grid>
              </Border>
              <Border Grid.Row="1" Background="#FFE3E8E9"/>
              <Grid Grid.Row="1" Width="810" Height="286" Margin="0,18,0,0" HorizontalAlignment="Center" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="138"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="510"/>
                  <ColumnDefinition Width="12"/>
                  <ColumnDefinition Width="138"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                  <Button Height="76" DataContext="{Binding SearchCursorLeftKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/cursor-lb.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="120" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-8,8,-8,0"/>
                      <TextBlock Text="Left" Grid.Row="1" FontSize="18" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                  <Button Height="76" Margin="0,6,0,0" DataContext="{Binding SearchSymbolsKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/symbols.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="78" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-6,7,-6,0" Opacity="0.7"/>
                      <TextBlock Grid.Row="1" FontSize="18" HorizontalAlignment="Center" Margin="0,1,0,0" Text="{Binding Label}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                  <Button Name="FriendSearchCapsButton" Height="88" Margin="0,6,0,0" DataContext="{Binding SearchCapsKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/caps.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="78" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Margin="-8,6,-8,0"/>
                      <TextBlock Text="Caps" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Margin="0,2,0,0" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                </StackPanel>
                <Grid Grid.Column="2">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="168"/>
                    <RowDefinition Height="76"/>
                  </Grid.RowDefinitions>
                  <ItemsControl Name="FriendSearchOverlayMainKeysItems" ItemsSource="{Binding SearchMainKeys}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid Columns="10"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Height="38" FontSize="18" FontWeight="SemiBold" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchKeyboard360Style}"/>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Grid Grid.Row="1" Margin="0,14,0,0" VerticalAlignment="Top">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Name="FriendSearchBackspaceButton" Grid.Column="0" Height="42" VerticalAlignment="Top" DataContext="{Binding SearchBackspaceKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FF2D80B6" Margin="0,0,8,0">
                          <TextBlock Text="X" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Backspace" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                    <Button Name="FriendSearchSpaceButton" Grid.Column="1" Height="42" VerticalAlignment="Top" Margin="6,0,0,0" DataContext="{Binding SearchSpaceKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="11" Background="#FFD0AC2C" Margin="0,0,8,0">
                          <TextBlock Text="Y" Foreground="#FFFFFFFF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="Space" FontSize="20" FontWeight="SemiBold" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                      </StackPanel>
                    </Button>
                  </Grid>
                </Grid>
                <StackPanel Grid.Column="4">
                  <Button Height="76" DataContext="{Binding SearchCursorRightKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="42"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/cursor-rb.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="120" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-8,8,-8,0"/>
                      <TextBlock Text="Right" Grid.Row="1" FontSize="18" HorizontalAlignment="Center" Margin="0,1,0,0" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                  <Button Height="76" Margin="0,6,0,0" DataContext="{Binding SearchAccentsKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="40"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/accents.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="78" Height="38" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="-6,7,-6,0" Opacity="0.7"/>
                      <TextBlock Grid.Row="1" FontSize="18" HorizontalAlignment="Center" Margin="0,1,0,0" Text="{Binding Label}" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                  <Button Name="FriendSearchDoneButton" Height="88" Margin="0,6,0,0" DataContext="{Binding SearchDoneKey}" Command="{Binding DataContext.ActivateSearchKeyCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideSearchUtility360Style}">
                    <Grid VerticalAlignment="Center">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <Image Source="{Binding Source=Assets/Misc/SearchMenuIcons/done.png, Converter={StaticResource StringToImageSourceConverter}}" Grid.Row="0" Width="50" Height="50" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform" Margin="0,5,0,0"/>
                      <TextBlock Text="Done" Grid.Row="1" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0" Foreground="{Binding Path=Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    </Grid>
                  </Button>
                </StackPanel>
              </Grid>
            </Grid>
          </Border>
          <ContentControl Grid.Row="2" Margin="0,4,0,0" Theme="{StaticResource GuideOverlayFooterStyle}"/>
        </Grid>
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" Fill="#76000000" IsHitTestVisible="False" w:Wpf.Visibility="{Binding IsFriendProfileScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        <Grid Name="FriendProfileOverlay" Canvas.Left="210" Canvas.Top="50" Width="860" Height="606" Opacity="0" w:Wpf.Visibility="{Binding IsFriendProfileScreen, Converter={StaticResource BooleanToVisibilityConverter}}" RenderTransformOrigin="0%,0%">
          <Grid.RenderTransform>
            <TranslateTransform X="0"/>
          </Grid.RenderTransform>
          <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="526"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid Row="0" Margin="16,0,16,0">
            <TextBlock Text="Profile" Foreground="#FFFFFFFF" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center"/>
            <Border Width="36" Height="36" Margin="0,-8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FF6FD3F2" BorderBrush="#80FFFFFF" BorderThickness="1">
              <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
            </Border>
            <TextBlock Foreground="#FFFFFFFF" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center" Text="{Binding ClockText}"/>
          </Grid>
          <Border Grid.Row="1" Background="#F1DDE3E5" BorderBrush="#FF949EA3" BorderThickness="1">
            <Border.Effect>
              <DropShadowEffect BlurRadius="22" Color="#FF000000" Opacity="0.5" OffsetX="0" OffsetY="0"/>
            </Border.Effect>
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="0"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Border Grid.Row="0" w:Wpf.Visibility="Collapsed">
                <Border.Background>
                  <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#FF091009" Offset="0"/>
                    <GradientStop Color="#FF101010" Offset="0.5"/>
                    <GradientStop Color="#FF0A0D0A" Offset="1"/>
                  </LinearGradientBrush>
                </Border.Background>
                <Grid Margin="16,0,16,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Profile" Foreground="#FFFFFFFF" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <Border Grid.Column="1" Width="36" Height="36" Margin="0,-8,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Background="#FF6FD3F2" BorderBrush="#80FFFFFF" BorderThickness="1">
                    <Image Stretch="UniformToFill" Source="{Binding GamerPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                  </Border>
                  <TextBlock Grid.Column="2" Foreground="#FFFFFFFF" FontSize="18" VerticalAlignment="Center" Text="{Binding ClockText}"/>
                </Grid>
              </Border>
              <Grid Row="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="430"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Column="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="60"/>
                    <RowDefinition Height="*"/>
                  </Grid.RowDefinitions>
                  <Border Grid.Row="0" Background="#FFF8F8F8" BorderBrush="#FFC4CACC" BorderThickness="0,0,1,1">
                    <TextBlock Text="Gamer Profile" Margin="18,0,0,0" VerticalAlignment="Center" Foreground="#FF34383A" FontSize="22" FontWeight="SemiBold"/>
                  </Border>
                  <ListBox Name="FriendProfileOverlayActionsList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" ItemsSource="{Binding FriendProfileActions}" SelectedIndex="{Binding SelectedFriendProfileActionIndex, Mode=TwoWay}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ItemContainerTheme="{StaticResource GuideFriendProfileOverlayActionStyle}" PointerReleased="FriendProfileActions_OnMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                      <DataTemplate>
                        <Grid Margin="24,0,10,0">
                          <TextBlock FontSize="21" VerticalAlignment="Center" Text="{Binding Title}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
                        </Grid>
                      </DataTemplate>
                    </ListBox.ItemTemplate>
                  </ListBox>
                </Grid>
                <Border Grid.Column="1" Background="#D0ABB2B6" BorderBrush="#FFC2C9CC" BorderThickness="1,0,0,0">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="60"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#FF74818A" BorderBrush="#FFC2C9CC" BorderThickness="0,0,0,1">
                      <TextBlock Text="Personal Profile" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="22" FontWeight="SemiBold"/>
                    </Border>
                    <Grid Row="1" Margin="14,14,14,14">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="46"/>
                        <RowDefinition Height="116"/>
                        <RowDefinition Height="*"/>
                      </Grid.RowDefinitions>
                      <Border Background="#FFAAAEB1" BorderBrush="#D8E4E7E8" BorderThickness="1">
                        <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFFFF" Text="{Binding ActiveFriendGamertag}"/>
                      </Border>
                      <Border Grid.Row="1" Background="#FFFAFAFA" BorderBrush="#CCD1D7DA" BorderThickness="1,0,1,1">
                        <Grid Margin="14,12,14,10">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="104"/>
                            <ColumnDefinition Width="*"/>
                          </Grid.ColumnDefinitions>
                          <Border Width="88" Height="88" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#FFBEC5C9" BorderBrush="#FF98A2A8" BorderThickness="1">
                            <Image Stretch="UniformToFill" Source="{Binding ActiveFriendPicturePath, Converter={StaticResource StringToImageSourceConverter}}"/>
                          </Border>
                          <Grid Column="1" Margin="4,-1,0,0">
                            <Grid.RowDefinitions>
                              <RowDefinition Height="31"/>
                              <RowDefinition Height="29"/>
                              <RowDefinition Height="29"/>
                            </Grid.RowDefinitions>
                            <Grid Row="0">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="Rep" Foreground="#FF424A4F" FontSize="18" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Foreground="#FFE17E26" FontSize="25" VerticalAlignment="Center" Text="{Binding ActiveFriendReputation}"/>
                            </Grid>
                            <Grid Row="1">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="Gamerscore" Foreground="#FF424A4F" FontSize="18" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Foreground="#FF34383A" FontSize="18" VerticalAlignment="Center" Text="{Binding ActiveFriendGamerscore}"/>
                            </Grid>
                            <Grid Row="2">
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="84"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <TextBlock Text="Zone" Foreground="#FF424A4F" FontSize="18" VerticalAlignment="Center"/>
                              <TextBlock Grid.Column="1" Foreground="#FF34383A" FontSize="18" VerticalAlignment="Center" Text="{Binding ActiveFriendZone}"/>
                            </Grid>
                          </Grid>
                        </Grid>
                      </Border>
                      <Border Grid.Row="2" Background="#C69CA4A8" BorderBrush="#CCD1D7DA" BorderThickness="1,0,1,1">
                        <Grid Margin="12,10,12,10">
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                          </Grid.RowDefinitions>
                          <TextBlock FontSize="21" Foreground="#FFFFFFFF" Text="{Binding ActiveFriendCountry}"/>
                          <Grid Row="1" Margin="0,14,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="72"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56" Height="56" HorizontalAlignment="Left" VerticalAlignment="Top" Background="#EEF7F8F8" BorderBrush="#66FFFFFF" BorderThickness="1" ClipToBounds="True">
                              <Image Stretch="UniformToFill" Source="{Binding ActiveFriendGameIconPath, Converter={StaticResource StringToImageSourceConverter}}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Width="300" Margin="0,4,0,0" Foreground="#FFFFFFFF" FontSize="21" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" Text="{Binding ActiveFriendGameTitle}"/>
                          </Grid>
                          <TextBlock Grid.Row="2" FontSize="18" Foreground="#FFF4F6F7" VerticalAlignment="Bottom" Text="{Binding ActiveFriendStatus}"/>
                          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,2,2">
                            <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#79F2F5F6" FontSize="18" Margin="0,0,10,0"/>
                            <TextBlock Text="🗣" FontFamily="avares://DashX360/Fonts#Noto Sans Symbols 2, DejaVu Sans, avares://DashX360/Fonts#Selawik" Foreground="#79F2F5F6" FontSize="18"/>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>
              </Grid>
            </Grid>
          </Border>
          <ContentControl Grid.Row="2" Theme="{StaticResource GuideOverlayFooterStyle}" w:Wpf.Visibility="{Binding IsMainGuideScreen, Converter={StaticResource BooleanToVisibilityConverter}}"/>
        </Grid>
        <Grid Name="GuideMusicOverlay" Canvas.Left="0" Canvas.Top="0" Width="1280" Height="720" ZIndex="20" Background="#00FFFFFF" Opacity="0" RenderTransformOrigin="50%,50%" w:Wpf.Visibility="{Binding IsGuideMusicPickerScreen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Grid.RenderTransform>
            <TransformGroup>
              <ScaleTransform ScaleX="1" ScaleY="1"/>
              <TranslateTransform X="0"/>
            </TransformGroup>
          </Grid.RenderTransform>
          <TextBlock Name="GuideMusicHeader" Text="Now Playing" Foreground="#F2FFFFFF" FontSize="32" FontWeight="Light" Margin="148,52,0,0"/>
          <Grid Name="GuideMusicContentGrid" Width="880" Height="482" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="440"/>
              <ColumnDefinition Width="440"/>
            </Grid.ColumnDefinitions>
            <Border Background="#EEF0F2F1"/>
            <Border Grid.Column="1" Background="#D9AEB4B7"/>
            <Grid Name="GuideMusicMenuContent" Grid.ColumnSpan="2">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="440"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="26,18,26,0">
                <StackPanel Orientation="Horizontal">
                  <Button Width="58" Height="38" Content="{Binding Dashboard.MusicPlayPauseText}" Command="{Binding Dashboard.PlayPauseMusicCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                  <Button Width="58" Height="38" Content="Prev" Margin="5,0,0,0" Command="{Binding Dashboard.PreviousMusicCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                  <Button Width="58" Height="38" Content="Stop" Margin="5,0,0,0" Command="{Binding Dashboard.StopMusicCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                  <Button Width="58" Height="38" Content="Next" Margin="5,0,0,0" Command="{Binding Dashboard.NextMusicCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                  <Button Width="82" Height="38" Margin="5,0,0,0" Content="{Binding Dashboard.ShuffleText}" Command="{Binding Dashboard.ToggleShuffleMusicCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                </StackPanel>
                <TextBlock Text="Edit or Save Playlist" Foreground="#FF55595C" FontSize="22" Margin="0,20,0,14"/>
                <TextBlock Foreground="#FF55595C" FontSize="21" TextTrimming="CharacterEllipsis" Margin="0,22,0,8" Text="{Binding Dashboard.CurrentMusicTitle}"/>
                <Grid Height="44">
                  <Border Height="8" Background="#FFB5BABB" VerticalAlignment="Top" Margin="0,8,0,0"/>
                  <ProgressBar Height="8" Minimum="0" Maximum="100" Foreground="#FF6D7173" Background="#00FFFFFF" BorderThickness="0" VerticalAlignment="Top" Margin="0,8,0,0" Value="{Binding Dashboard.MusicProgress}" HorizontalAlignment="Stretch"/>
                  <TextBlock Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Left" VerticalAlignment="Bottom" Text="{Binding Dashboard.MusicPositionText}"/>
                  <TextBlock Foreground="#FF55595C" FontSize="16" HorizontalAlignment="Right" VerticalAlignment="Bottom" Text="{Binding Dashboard.MusicDurationText}"/>
                </Grid>
                <Grid Margin="0,24,0,0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="128"/>
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="96"/>
                  </Grid.RowDefinitions>
                  <Border ClipToBounds="True">
                    <controls:MusicVisualizer IsActive="{Binding Dashboard.IsMusicPlaying}" Volume="{Binding Dashboard.MusicVolume}" Progress="{Binding Dashboard.MusicProgress}" Bass="{Binding Dashboard.VisualizerBass}" Mid="{Binding Dashboard.VisualizerMid}" Treble="{Binding Dashboard.VisualizerTreble}" Loudness="{Binding Dashboard.VisualizerLoudness}" Peak="{Binding Dashboard.VisualizerPeak}"/>
                  </Border>
                  <Border Grid.Row="2" Background="#FFE2E5E4">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="Music Files" Foreground="#FF6B7174" FontSize="22" FontWeight="Light" HorizontalAlignment="Center"/>
                      <TextBlock Text="Assets\Custom Files\Music Files" Foreground="#FF7D8385" FontSize="13" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <TextBlock Foreground="#FF7D8385" FontSize="15" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding Dashboard.MusicVolumeText, StringFormat=Volume {0}}"/>
                        <Button Width="68" Height="28" Content="Vol -" Command="{Binding Dashboard.VolumeDownCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                        <Button Width="68" Height="28" Content="Vol +" Margin="8,0,0,0" Command="{Binding Dashboard.VolumeUpCommand}" Theme="{StaticResource GuideMusicPlayerButtonStyle}"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                </Grid>
              </StackPanel>
              <Grid Grid.Column="1" Margin="0,12,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                  <ItemsControl ItemsSource="{Binding Dashboard.MusicTracks}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Button Height="48" Command="{Binding DataContext.Dashboard.PlaySelectedMusicCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Theme="{StaticResource GuideMusicTrackButtonStyle}">
                          <Grid Background="#21FFFFFF">
                            <TextBlock Foreground="#FF5F6669" FontSize="21" Margin="30,0,24,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Text="{Binding Title}"/>
                            <TextBlock Text="playing" Foreground="{DynamicResource MetroGreenBrush}" FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                              <TextBlock.Theme>
                                <ControlTheme TargetType="TextBlock">
                                  <Setter Property="w:Wpf.Visibility" Value="Collapsed"/>
                                  <Setter Property="w:WpfTriggers.ThemeTriggers"><Template><w:TriggerCollection><w:DataTrigger Value="True" Binding="{Binding IsPlaying}">
                                      <w:Setter Property="Visibility" Value="Visible"/>
                                    </w:DataTrigger></w:TriggerCollection></Template></Setter>
                                </ControlTheme>
                              </TextBlock.Theme>
                            </TextBlock>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <TextBlock Foreground="#FF5F6669" FontSize="15" VerticalAlignment="Bottom" Margin="30,0,0,24" Text="{Binding Dashboard.MusicTrackCountText}"/>
              </Grid>
            </Grid>
          </Grid>
          <StackPanel Name="GuideMusicFooter" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="145,0,0,58">
            <Border Width="20" Height="20" CornerRadius="10" Background="#FF6CB344">
              <TextBlock Text="A" Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Select   " Foreground="#E6FFFFFF" FontSize="16"/>
            <Border Width="20" Height="20" CornerRadius="10" Background="#FFD73A3A" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp">
              <TextBlock Text="B" Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text=" Back   " Foreground="#E6FFFFFF" FontSize="16" Cursor="Hand" PointerReleased="BackHint_OnMouseLeftButtonUp"/>
            <Grid Background="#00FFFFFF" Cursor="Hand" PointerReleased="GuideMusicFullscreenHint_OnMouseLeftButtonUp">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="20" Height="20" CornerRadius="10" Background="#FF2574AA">
                  <TextBlock Text="X" Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text=" Fullscreen Visualizer" Foreground="#E6FFFFFF" FontSize="16"/>
              </StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
        <Grid Canvas.Left="404" Canvas.Top="244" Width="472" Height="156" w:Wpf.Visibility="{Binding IsSocialMessageOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
          <Border Background="#FF15191B" BorderBrush="#FF5B6368" BorderThickness="1,1,1,0" Height="40" VerticalAlignment="Top">
            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Foreground="#FFFFFFFF" FontSize="18" Text="{Binding SocialMessageTitle}"/>
          </Border>
          <Border Margin="0,40,0,0" Background="#FFE8ECEE" BorderBrush="#FF98A2A8" BorderThickness="1">
            <TextBlock Margin="24,0,24,0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Foreground="#FF333638" FontSize="20" Text="{Binding SocialMessageText}"/>
          </Border>
        </Grid>
        <TextBlock Canvas.Left="477" Canvas.Top="614" Foreground="#CCFFFFFF" FontSize="15" Text="{Binding StatusText}" w:Wpf.Visibility="{Binding ShowStatusText, Converter={StaticResource BooleanToVisibilityConverter}}"/>
      </Canvas>
    </Viewbox>
  </Grid>
</Window>
