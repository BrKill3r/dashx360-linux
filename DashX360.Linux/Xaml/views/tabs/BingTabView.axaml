<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:tabs="using:XboxMetroLauncher.Views.Tabs" x:Class="XboxMetroLauncher.Views.Tabs.BingTabView" xmlns:w="using:XboxMetroLauncher.Compat">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <Canvas Name="HomeAlignedFrame" Width="764" Height="368" ClipToBounds="False" Canvas.Left="198" Canvas.Top="11">
        <Canvas Name="ContentTileLayer" Width="764" Height="368" Canvas.Left="0" Canvas.Top="0">
          <TextBlock Text="Search Xbox for games, movies, music and apps" Canvas.Left="180" Canvas.Top="93" Foreground="#BFFFFFFF" FontSize="19" FontWeight="Light"/>
          <TextBlock Text="bing" Canvas.Left="0" Canvas.Top="137" Foreground="#F2FFFFFF" FontSize="44" FontWeight="Light"/>
          <Border Name="SearchBoxFrame" Canvas.Left="179" Canvas.Top="123" Width="585" Height="92" BorderBrush="#C9FFFFFF" BorderThickness="2" Background="#C8000000" PointerPressed="SearchBoxFrame_OnMouseLeftButtonDown">
            <Grid>
              <TextBox Name="BingSearchBox" Background="#00FFFFFF" BorderThickness="0" Foreground="#F2FFFFFF" CaretBrush="#FFFFFFFF" FontSize="40" FontWeight="Light" Padding="28,18,84,0" Text="{Binding Shell.SearchQuery, UpdateSourceTrigger=PropertyChanged}" KeyDown="BingSearchBox_OnKeyDown" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
              <Path Stroke="#F2FFFFFF" StrokeThickness="5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,34,0" Width="50" Height="50" Data="M17,17 A14,14 0 1 1 36,36M34,34 L47,47" StrokeLineCap="Round"/>
            </Grid>
          </Border>
          <Button Canvas.Left="681" Canvas.Top="123" Width="83" Height="92" Opacity="0" Command="{Binding SubmitSearchCommand}" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
        </Canvas>
      </Canvas>
    </Canvas>
  </Grid>
</UserControl>
