<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="XboxMetroLauncher.Views.Tabs.SocialTabView" xmlns:w="using:XboxMetroLauncher.Compat">
  <Grid Background="#00FFFFFF" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Canvas Name="DashboardCanvas" Width="1280" Height="502" ClipToBounds="False" HorizontalAlignment="Left" VerticalAlignment="Top">
      <StackPanel Canvas.Left="-40" Canvas.Top="72" Opacity="0.72" w:Wpf.Visibility="Collapsed">
        <Button Width="138" Height="222" Theme="{StaticResource X360TileButtonStyle}">
          <Grid Background="#FFE43333">
            <TextBlock Text="NETFLIX" Foreground="#FFFFFFFF" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
        </Button>
      </StackPanel>
      <Canvas Name="HomeAlignedFrame" Canvas.Left="224" Canvas.Top="31" Width="764" Height="368" ClipToBounds="False">
        <Canvas Name="SocialArtLayer" Width="764" Height="368" IsHitTestVisible="False" Canvas.Left="0" Canvas.Top="0">
          <Image Canvas.Left="535" Canvas.Top="78" Width="230" Height="168" Stretch="Uniform" Opacity="0.82" Source="{Binding Source=Assets/Tiles/Social/join_the_fun_text.png, Converter={StaticResource CropImageSourceConverter}, ConverterParameter=294;102;782;594}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
          <Image Canvas.Left="219" Canvas.Top="87" Width="300" Height="256" Stretch="Uniform" Opacity="0.96" Source="{Binding Source=Assets/Tiles/Social/transparent_avatars.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=384}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
        </Canvas>
        <Canvas Name="ContentTileLayer" Width="764" Height="368" Canvas.Left="0" Canvas.Top="0">
          <Button Canvas.Left="0" Canvas.Top="0" Width="177" Height="122" Command="{Binding Shell.OpenFriendsOverlayCommand}" Theme="{StaticResource X360TileButtonStyle}">
            <Grid Background="{Binding Shell.DashboardTileBrush}">
              <Image Width="58" Height="58" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,0,0" Source="{Binding Source=Assets/Tiles/Social/friends.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock Text="Friends" Foreground="#FFFFFFFF" FontSize="13" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
            </Grid>
          </Button>
          <Button Canvas.Left="0" Canvas.Top="123" Width="177" Height="122" Command="{Binding Shell.OpenThemeMenuCommand}" Theme="{StaticResource X360TileButtonStyle}">
            <Grid Background="{Binding Shell.DashboardTileBrush}">
              <Image Width="58" Height="58" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,0,0" Source="{Binding Source=Assets/Misc/SettingsIcons/preferences.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock Text="Themes" Foreground="#FFFFFFFF" FontSize="13" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
            </Grid>
          </Button>
          <Button Canvas.Left="0" Canvas.Top="246" Width="177" Height="122" Theme="{StaticResource X360TileButtonStyle}">
            <Grid Background="{Binding Shell.DashboardTileBrush}">
              <Image Width="58" Height="58" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-15,0,0" Source="{Binding Source=Assets/Tiles/Social/sign_in_or_out.png, Converter={StaticResource StringToImageSourceConverter}, ConverterParameter=128}" RenderOptions.BitmapInterpolationMode="HighQuality"/>
              <TextBlock Text="Sign in or Out" Foreground="#FFFFFFFF" FontSize="13" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
            </Grid>
          </Button>
        </Canvas>
      </Canvas>
      <StackPanel Canvas.Left="1115" Canvas.Top="11" Opacity="0.72" w:Wpf.Visibility="Collapsed">
        <Button Width="72" Height="75" Theme="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="TV" Foreground="#FFFFFFFF" FontSize="13" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
          </Grid>
        </Button>
        <Button Width="72" Height="75" Margin="0,1,0,0" Theme="{StaticResource X360TileButtonStyle}">
          <Grid Background="{Binding Shell.DashboardTileBrush}">
            <TextBlock Text="Program&#10;Guide" Foreground="#FFFFFFFF" FontSize="13" Margin="6,0,0,8" VerticalAlignment="Bottom"/>
          </Grid>
        </Button>
      </StackPanel>
    </Canvas>
  </Grid>
</UserControl>
